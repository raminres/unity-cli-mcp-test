# Auto-detect text files and perform LF normalization
* text=auto

# Text formats
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.compute text
*.json text
*.xml text
*.yaml text
*.yml text
*.md text
*.txt text

# Unity YAML (allow text diffs for scene, prefab, mat, anim, controller)
*.unity text
*.prefab text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.physicMaterial text
*.physicsMaterial2D text
*.meta text

# --------------------------------------------------
# Git LFS Rules for Binary Assets
# --------------------------------------------------

# 3D Formats
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
