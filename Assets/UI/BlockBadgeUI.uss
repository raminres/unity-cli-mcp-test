.badge-root {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: transparent;
}

.badge-plate {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border-radius: 18px;
    border-width: 3px;
    background-color: rgba(10, 12, 20, 0.88);
}

.badge-plate-x2 {
    border-color: #ffd700;
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.75);
}

.badge-plate-x3 {
    border-color: #ff4757;
    box-shadow: 0 0 12px rgba(255, 71, 87, 0.85);
}

.badge-plate-expander {
    border-color: #00f2fe;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.8);
}

.badge-icon {
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
    flex-shrink: 0;
}

.badge-icon-expander {
    width: 52px;
    height: 52px;
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Arrows_Outward.png?fileID=21300000&guid=a78437860f4b9b54184a24a248743a7d&type=3#TX_Powerup_Arrows_Outward");
    -unity-background-image-tint-color: #00f2fe;
}

.badge-icon-points {
    width: 34px;
    height: 34px;
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Extra_Points.png?fileID=21300000&guid=1d8d97a548b3e734687c47462e523395&type=3#TX_Powerup_Extra_Points");
}

.badge-icon-points-x2 {
    -unity-background-image-tint-color: #ffd700;
}

.badge-icon-points-x3 {
    -unity-background-image-tint-color: #ff4757;
}

.badge-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 0;
    margin: 1px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
    flex-shrink: 0;
}

.badge-text-x2 {
    color: #ffe066;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.9);
}

.badge-text-x3 {
    color: #ff6b81;
    text-shadow: 0 0 10px rgba(255, 71, 87, 0.95);
}

.badge-text-expander {
    display: none;
}
