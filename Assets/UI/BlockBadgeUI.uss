.badge-root {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
}

.badge-plate {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border-radius: 18px;
    border-width: 3px;
    background-color: rgba(10, 12, 20, 0.88);
}

.badge-plate-x2 {
    border-color: #ffd700;
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.75);
}

.badge-plate-x3 {
    border-color: #ff4757;
    box-shadow: 0 0 12px rgba(255, 71, 87, 0.85);
}

.badge-plate-x4 {
    border-color: #ff1744;
    box-shadow: 0 0 14px rgba(255, 23, 68, 0.9);
}

.badge-plate-x5 {
    border-color: #d500f9;
    box-shadow: 0 0 14px rgba(213, 0, 249, 0.95);
}

.badge-plate-expander {
    border-color: #00f2fe;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.8);
}

.badge-plate-bomb {
    border-color: #ff5722;
    box-shadow: 0 0 14px rgba(255, 87, 34, 0.9);
}

.badge-plate-heart-plus {
    border-color: #ff2a6d;
    box-shadow: 0 0 14px rgba(255, 42, 109, 0.9);
}

.badge-plate-shield {
    border-color: #00f2fe;
    box-shadow: 0 0 14px rgba(0, 242, 254, 0.9);
}

.badge-plate-multiball {
    border-color: #e056fd;
    box-shadow: 0 0 14px rgba(224, 86, 253, 0.9);
}

.badge-plate-laser {
    border-color: #ff2a47;
    box-shadow: 0 0 14px rgba(255, 42, 71, 0.9);
}

.badge-plate-powerup {
    border-color: #00f2fe;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.85);
}

.badge-plate-powerdown {
    border-color: #ff1744;
    box-shadow: 0 0 14px rgba(255, 23, 68, 0.95);
}

.badge-icon {
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
    flex-shrink: 0;
}

.badge-icon-expander {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #00f2fe;
}

.badge-icon-bomb {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #ff6b35;
}

.badge-icon-heart-plus {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #ff3b56;
}

.badge-icon-shield {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #00f2fe;
}

.badge-icon-multiball {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #e056fd;
}

.badge-icon-laser {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #ff2a47;
}

.badge-icon-points {
    width: 34px;
    height: 34px;
}

.badge-icon-points-x2 {
    -unity-background-image-tint-color: #ffd700;
}

.badge-icon-points-x3 {
    -unity-background-image-tint-color: #ff4757;
}

.badge-icon-points-x4 {
    -unity-background-image-tint-color: #ff1744;
}

.badge-icon-points-x5 {
    -unity-background-image-tint-color: #d500f9;
}

.badge-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 0;
    margin: 1px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
    flex-shrink: 0;
}

.badge-text-x2 {
    color: #ffe066;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.9);
}

.badge-text-x3 {
    color: #ff6b81;
    text-shadow: 0 0 10px rgba(255, 71, 87, 0.95);
}

.badge-text-x4 {
    color: #ff5252;
    text-shadow: 0 0 10px rgba(255, 23, 68, 0.95);
}

.badge-text-x5 {
    color: #ea80fc;
    text-shadow: 0 0 10px rgba(213, 0, 249, 0.95);
}

.badge-text-expander {
    display: none;
}

.badge-text-hidden {
    display: none;
}

.badge-icon-powerup {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #00f2fe;
}

.badge-icon-powerdown {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #ff1744;
}

.badge-text-powerdown {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ff1744;
    letter-spacing: 0.5px;
    text-shadow: 0 0 10px rgba(255, 23, 68, 0.95);
}
