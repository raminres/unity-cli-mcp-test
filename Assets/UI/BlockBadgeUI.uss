.badge-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: transparent;
}

.badge-plate {
    width: 210px;
    height: 210px;
    align-items: center;
    justify-content: center;
    border-radius: 40px;
    border-width: 8px;
    background-color: rgba(10, 12, 20, 0.85);
}

.badge-plate-x2 {
    border-color: #ffd700;
    box-shadow: 0 0 25px rgba(255, 215, 0, 0.8);
}

.badge-plate-x3 {
    border-color: #ff4757;
    box-shadow: 0 0 25px rgba(255, 71, 87, 0.85);
}

.badge-plate-expander {
    border-color: #00f2fe;
    box-shadow: 0 0 25px rgba(0, 242, 254, 0.8);
}

.badge-text {
    font-size: 110px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.badge-text-x2 {
    color: #ffe066;
    text-shadow: 0 0 20px rgba(255, 215, 0, 0.9);
}

.badge-text-x3 {
    color: #ff6b81;
    text-shadow: 0 0 20px rgba(255, 71, 87, 0.95);
}

.badge-text-expander {
    color: #4facfe;
    font-size: 78px;
    text-shadow: 0 0 20px rgba(79, 172, 254, 0.9);
}
