.badge-root {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: transparent;
}

.badge-plate {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border-radius: 18px;
    border-width: 3px;
    background-color: rgba(10, 12, 20, 0.88);
}

.badge-plate-x2 {
    border-color: #ffd700;
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.75);
}

.badge-plate-x3 {
    border-color: #ff4757;
    box-shadow: 0 0 12px rgba(255, 71, 87, 0.85);
}

.badge-plate-expander {
    border-color: #00f2fe;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.8);
}

.badge-plate-bomb {
    border-color: #ff5722;
    box-shadow: 0 0 14px rgba(255, 87, 34, 0.9);
}

.badge-plate-heart-plus {
    border-color: #ff2a6d;
    box-shadow: 0 0 14px rgba(255, 42, 109, 0.9);
}

.badge-plate-shield {
    border-color: #00f2fe;
    box-shadow: 0 0 14px rgba(0, 242, 254, 0.9);
}

.badge-plate-multiball {
    border-color: #e056fd;
    box-shadow: 0 0 14px rgba(224, 86, 253, 0.9);
}

.badge-icon {
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
    flex-shrink: 0;
}

.badge-icon-expander {
    width: 52px;
    height: 52px;
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Arrows_Outward.png?fileID=21300000&guid=a78437860f4b9b54184a24a248743a7d&type=3#TX_Powerup_Arrows_Outward");
    -unity-background-image-tint-color: #00f2fe;
}

.badge-icon-bomb {
    width: 52px;
    height: 52px;
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Bomb.png?fileID=21300000&guid=d4796fe8b40cb6c45985a6cda1c74774&type=3#TX_Powerup_Bomb");
    -unity-background-image-tint-color: #ff6b35;
}

.badge-icon-heart-plus {
    width: 52px;
    height: 52px;
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Heart_Plus.png?fileID=21300000&guid=f74a7249ed4d1154cb7323e34df14e78&type=3#TX_Powerup_Heart_Plus");
    -unity-background-image-tint-color: #ff3b56;
}

.badge-icon-shield {
    width: 52px;
    height: 52px;
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Shield.png?fileID=3950488328852594513&guid=16428cb230612564080e96abe31d3eea&type=3#TX_Powerup_Shield_0");
    -unity-background-image-tint-color: #00f2fe;
}

.badge-icon-multiball {
    width: 52px;
    height: 52px;
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Multi_Ball.png?fileID=-5547497205224055285&guid=3098a697d024c2547bdafd3878c03c4b&type=3#TX_Powerup_Multi_Ball_0");
    -unity-background-image-tint-color: #e056fd;
}

.badge-icon-points {
    width: 34px;
    height: 34px;
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Extra_Points.png?fileID=21300000&guid=1d8d97a548b3e734687c47462e523395&type=3#TX_Powerup_Extra_Points");
}

.badge-icon-points-x2 {
    -unity-background-image-tint-color: #ffd700;
}

.badge-icon-points-x3 {
    -unity-background-image-tint-color: #ff4757;
}

.badge-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 0;
    margin: 1px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
    flex-shrink: 0;
}

.badge-text-x2 {
    color: #ffe066;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.9);
}

.badge-text-x3 {
    color: #ff6b81;
    text-shadow: 0 0 10px rgba(255, 71, 87, 0.95);
}

.badge-text-expander {
    display: none;
}

.badge-text-hidden {
    display: none;
}
