    letter-spacing: 1px;
}

.combo-badge.mult-tier-2x .combo-val-text {
    color: rgb(255, 215, 0);
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.8);
}

.combo-badge.mult-tier-3x .combo-val-text {
    color: rgb(255, 140, 0);
