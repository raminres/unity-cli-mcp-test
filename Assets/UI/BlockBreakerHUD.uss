.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    pointer-events: none; /* Let gameplay clicks pass through background */
}

/* Top Bar */
.top-bar {
    margin-top: 14px;
    margin-left: 18px;
    margin-right: 18px;
    height: 64px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(14, 18, 30, 0.88);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 0 20px;
    pointer-events: auto;
}

.score-container {
    justify-content: center;
}

.score-main {
    font-size: 20px;
    -unity-font-style: bold;
    color: #21d4fd;
    letter-spacing: 1px;
    margin: 0;
}

.score-sub {
    font-size: 13px;
    color: #94a3b8;
    letter-spacing: 0.5px;
    margin: 0;
}

/* Lives Heart Icons */
.lives-container {
    flex-direction: row;
    align-items: center;
}

.life-pip {
    width: 32px;
    height: 32px;
    margin: 0 5px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, -unity-background-image-tint-color, opacity;
    transition-duration: 0.25s, 0.25s, 0.25s;
    transition-timing-function: ease-out-back;
}

.pip-active {
    background-image: url("project://database/Assets/UI/Icons/TX_Heart_Fill.png?fileID=21300000&guid=5c78b93fab88e17459882a82ea8a4a6f&type=3#TX_Heart_Fill");
    -unity-background-image-tint-color: #ff3b56;
    opacity: 1;
    scale: 1 1;
}

.pip-lost {
    background-image: url("project://database/Assets/UI/Icons/TX_Heart_Empty.png?fileID=21300000&guid=c9c893b5713e23449815fbcff6eb5834&type=3#TX_Heart_Empty");
    -unity-background-image-tint-color: #ff3b56;
    opacity: 0.35;
    scale: 0.86 0.86;
}

.pip-hidden {
    display: none;
}

.pip-pop {
    scale: 1.45 1.45;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.flying-heart {
    position: absolute;
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/TX_Heart_Fill.png?fileID=21300000&guid=5c78b93fab88e17459882a82ea8a4a6f&type=3#TX_Heart_Fill");
    -unity-background-image-tint-color: #ff2a6d;
    -unity-background-scale-mode: scale-to-fit;
}

/* Active Powerup Indicators */
.powerup-status-container {
    margin-top: 10px;
    margin-left: 18px;
    margin-right: 18px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.powerup-badge {
    height: 42px;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    margin: 0 8px;
    border-radius: 21px;
    border-width: 1.5px;
    background-color: rgba(14, 18, 30, 0.9);
    transition-property: scale, opacity, translate;
    transition-duration: 0.25s, 0.25s, 0.25s;
    transition-timing-function: ease-out-back;
}

.shield-badge {
    border-color: #00f2fe;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.65);
}

.multiball-badge {
    border-color: #e056fd;
    box-shadow: 0 0 12px rgba(224, 86, 253, 0.65);
}

.powerup-status-icon {
    width: 26px;
    height: 26px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-shield {
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Shield.png?fileID=3950488328852594513&guid=16428cb230612564080e96abe31d3eea&type=3#TX_Powerup_Shield_0");
    -unity-background-image-tint-color: #00f2fe;
}

.icon-multiball {
    background-image: url("project://database/Assets/UI/Icons/TX_Powerup_Multi_Ball.png?fileID=-5547497205224055285&guid=3098a697d024c2547bdafd3878c03c4b&type=3#TX_Powerup_Multi_Ball_0");
    -unity-background-image-tint-color: #e056fd;
}

.powerup-timer-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 1px;
}

.shield-badge .powerup-timer-label {
    color: #00f2fe;
    text-shadow: 0 0 8px rgba(0, 242, 254, 0.8);
}

.multiball-badge .powerup-timer-label {
    color: #e056fd;
    text-shadow: 0 0 8px rgba(224, 86, 253, 0.8);
}

.powerup-hidden {
    display: none;
    opacity: 0;
    scale: 0.8 0.8;
}

/* Bouncy Quick Control Buttons */
.quick-controls {
    flex-direction: row;
    align-items: center;
}

.quick-btn {
    width: 46px;
    height: 46px;
    margin-left: 8px;
    border-radius: 14px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    font-size: 20px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color, translate;
    transition-duration: 0.25s, 0.15s, 0.15s, 0.25s;
    transition-timing-function: ease-out-back;
}

.quick-btn:hover {
    background-color: rgba(255, 255, 255, 0.24);
    border-color: rgba(33, 212, 253, 0.7);
    scale: 1.15 1.15;
    translate: 0 -2px;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.quick-btn:active {
    background-color: rgba(255, 255, 255, 0.06);
    scale: 0.86 0.86;
    translate: 0 2px;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

/* Quick Control Icons */
.quick-btn-icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #e2e8f0;
    transition-property: rotate, scale, -unity-background-image-tint-color;
    transition-duration: 0.5s, 0.2s, 0.2s;
    transition-timing-function: ease-out-back;
}

.quick-btn:hover .quick-btn-icon {
    -unity-background-image-tint-color: #21d4fd;
}

.quick-btn:hover .icon-volume-up {
    -unity-background-image-tint-color: #ff6e82;
}

.quick-btn:hover .icon-play {
    -unity-background-image-tint-color: #6ef5b2;
}

.icon-level-settings {
    background-image: url("project://database/Assets/UI/Icons/TX_Level_Settings.png?fileID=21300000&guid=31f75bf5242ae5841843e322927f8164&type=3#TX_Level_Settings");
}

.icon-volume-mute {
    background-image: url("project://database/Assets/UI/Icons/TX_Volume_Mute.png?fileID=21300000&guid=19323d3393a6acb4c9810de7a485552e&type=3#TX_Volume_Mute");
}

.icon-volume-up {
    background-image: url("project://database/Assets/UI/Icons/TX_Volume_Up.png?fileID=21300000&guid=9b70a43178d3e484aaa75e906b4ade94&type=3#TX_Volume_Up");
    -unity-background-image-tint-color: #ff3b56;
}

.icon-settings {
    background-image: url("project://database/Assets/UI/Icons/TX_Settings.png?fileID=21300000&guid=d24cd8b25486cfe45a7731b9a5d3afce&type=3#TX_Settings");
}

.icon-pause {
    background-image: url("project://database/Assets/UI/Icons/TX_Pause.png?fileID=21300000&guid=de14abab37824164b93573467f215b5c&type=3#TX_Pause");
}

.icon-play {
    background-image: url("project://database/Assets/UI/Icons/TX_Play.png?fileID=21300000&guid=dd600ea38ce338d4394fa625707eaee8&type=3#TX_Play");
    -unity-background-image-tint-color: #26e885;
}

/* Launch Banner */
.launch-banner {
    position: absolute;
    bottom: 130px;
    align-self: center;
    background-color: rgba(33, 212, 253, 0.15);
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.45);
    border-radius: 18px;
    padding: 12px 28px;
}

.launch-banner-hidden {
    display: none;
}

.launch-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    text-shadow: 0 0 10px rgba(33, 212, 253, 0.8);
}

/* Modals */
.modal-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 10, 18, 0.85);
    align-items: center;
    justify-content: center;
    pointer-events: auto;
}

.modal-hidden {
    display: none;
}

.modal-card {
    width: 360px;
    background-color: #171c2c;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 28px 24px;
    align-items: stretch;
}

.victory-card {
    border-color: rgba(38, 232, 133, 0.4);
}

.gameover-card {
    border-color: rgba(255, 59, 86, 0.4);
}

.modal-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    align-self: center;
    margin-bottom: 14px;
}

.victory-title {
    color: #26e885;
    text-shadow: 0 0 15px rgba(38, 232, 133, 0.6);
}

.gameover-title {
    color: #ff3b56;
    text-shadow: 0 0 15px rgba(255, 59, 86, 0.6);
}

.modal-score {
    font-size: 20px;
    -unity-font-style: bold;
    color: #21d4fd;
    align-self: center;
    margin-bottom: 4px;
}

.modal-subscore {
    font-size: 14px;
    color: #94a3b8;
    align-self: center;
    margin-bottom: 20px;
}

/* Bouncy Modal Arcade Buttons */
.arcade-btn {
    height: 54px;
    border-radius: 16px;
    border-width: 1.5px;
    margin-top: 12px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color, translate;
    transition-duration: 0.25s, 0.15s, 0.15s, 0.25s;
    transition-timing-function: ease-out-back;
}

.arcade-btn:hover {
    scale: 1.05 1.05;
    translate: 0 -2px;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.arcade-btn:active {
    scale: 0.92 0.92;
    translate: 0 3px;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

.btn-primary {
    background-color: #ff3b56;
    border-color: #ff6e82;
    color: #ffffff;
}

.btn-primary:hover {
    background-color: #ff546c;
    border-color: #ffffff;
}

.btn-primary:active {
    background-color: #d81e3a;
    border-color: #ff3b56;
}

.btn-secondary {
    background-color: #26e885;
    border-color: #6ef5b2;
    color: #0c0d16;
}

.btn-secondary:hover {
    background-color: #4df7a1;
    border-color: #ffffff;
}

.btn-secondary:active {
    background-color: #17be67;
    border-color: #26e885;
}

.btn-default {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
}

.btn-default:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
}

.btn-default:active {
    background-color: rgba(255, 255, 255, 0.04);
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.setting-label {
    font-size: 15px;
    color: #cbd5e1;
}

.setting-slider {
    width: 150px;
}

.setting-toggle {
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.setting-toggle .unity-toggle__input {
    justify-content: flex-end;
}

.setting-toggle .unity-toggle__checkmark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.45);
    background-color: rgba(33, 212, 253, 0.12);
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Icons/TX_Volume_Up.png?fileID=21300000&guid=9b70a43178d3e484aaa75e906b4ade94&type=3#TX_Volume_Up");
    -unity-background-image-tint-color: #21d4fd;
    scale: 1 1;
    transition-property: scale, background-color, border-color, -unity-background-image-tint-color;
    transition-duration: 0.2s, 0.15s, 0.15s, 0.2s;
    transition-timing-function: ease-out-back;
}

.setting-toggle:hover .unity-toggle__checkmark,
.setting-toggle > .unity-toggle__input:hover > .unity-toggle__checkmark {
    scale: 1.1 1.1;
    border-color: #21d4fd;
    background-color: rgba(33, 212, 253, 0.25);
}

.setting-toggle:checked .unity-toggle__checkmark,
.setting-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    border-color: rgba(255, 59, 86, 0.55);
    background-color: rgba(255, 59, 86, 0.16);
    background-image: url("project://database/Assets/UI/Icons/TX_Volume_Mute.png?fileID=21300000&guid=19323d3393a6acb4c9810de7a485552e&type=3#TX_Volume_Mute");
    -unity-background-image-tint-color: #ff3b56;
}

.setting-toggle:checked:hover .unity-toggle__checkmark,
.setting-toggle > .unity-toggle__input:checked:hover > .unity-toggle__checkmark {
    scale: 1.1 1.1;
    border-color: #ff546c;
    background-color: rgba(255, 59, 86, 0.3);
    -unity-background-image-tint-color: #ff6e82;
}

.fps-btn {
    width: 95px;
    height: 36px;
    border-radius: 10px;
    background-color: #252e46;
    border-color: rgba(255, 255, 255, 0.2);
    color: #21d4fd;
    -unity-font-style: bold;
    font-size: 14px;
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.fps-btn:hover {
    scale: 1.08 1.08;
    background-color: #2e3a58;
    transition-timing-function: ease-out-back;
}

.fps-btn:active {
    scale: 0.92 0.92;
    transition-duration: 0.08s;
}

.modal-close-btn {
    margin-top: 16px;
}

/* Level Settings Modal Extensions */
.modal-card-wide {
    width: 440px;
}

.level-tabs-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 12px;
}

.level-tab-btn {
    flex-grow: 1;
    min-width: 80px;
    height: 38px;
    margin: 3px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s, 0.15s, 0.15s;
    transition-timing-function: ease-out-back;
}

.level-tab-btn:hover {
    scale: 1.05 1.05;
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(33, 212, 253, 0.6);
}

.level-tab-btn:active {
    scale: 0.94 0.94;
}

.level-tab-active {
    background-color: #21d4fd;
    border-color: #21d4fd;
    color: #0c0d16;
}

.level-tab-active:hover {
    background-color: #55ddfe;
    border-color: #55ddfe;
    color: #0c0d16;
}

.level-name-display {
    font-size: 18px;
    -unity-font-style: bold;
    color: #21d4fd;
    align-self: center;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.level-desc-display {
    font-size: 12px;
    color: #94a3b8;
    align-self: center;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.setting-val-badge {
    width: 64px;
    font-size: 14px;
    -unity-font-style: bold;
    color: #21d4fd;
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.modal-action-btn {
    margin-top: 14px;
}
