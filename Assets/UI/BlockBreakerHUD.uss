    scale: 0.85;
    -unity-background-image-tint-color: rgb(100, 116, 139);
}

.star-earned {
    opacity: 1;
    scale: 1.15;
    -unity-background-image-tint-color: rgb(255, 215, 0);
}

.scorecard-table {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 16px 18px;
    margin-bottom: 16px;
    margin-top: 16px;
    margin-right: 16px;
    margin-left: 16px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.scorecard-row {
    flex-direction: row;
