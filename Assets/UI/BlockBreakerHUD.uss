    -unity-background-image-tint-color: rgb(0, 242, 254);
}

.timer-main {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(0, 242, 254, 0.6);
}

.score-delta {
    position: absolute;
    bottom: -22px;
    align-self: center;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 215, 0);
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.8);
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}

.delta-hidden {
    opacity: 0;
    translate: 0 8px;
}

.delta-visible {
    opacity: 1;
    translate: 0 -4px;
}

.flying-score {
    position: absolute;
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 215, 0);
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.9);
    padding: 3px 10px;
    border-radius: 12px;
    background-color: rgba(14, 18, 30, 0.85);
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.6);
    -unity-text-align: middle-center;
    pointer-events: none;
    letter-spacing: 0.5px;
}

.flying-score-normal {
    color: rgb(255, 215, 0);
    border-color: rgba(255, 215, 0, 0.65);
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.9);
}

.flying-score-combo {
    color: rgb(0, 242, 254);
    border-color: rgba(0, 242, 254, 0.75);
    text-shadow: 0 0 12px rgba(0, 242, 254, 0.95);
}

.flying-score-bomb {
    color: rgb(255, 132, 0);
    border-color: rgba(255, 132, 0, 0.85);
    text-shadow: 0 0 14px rgb(255, 132, 0);
}

.flying-score-clutch {
    color: rgb(255, 42, 109);
    border-color: rgba(255, 42, 109, 0.9);
    text-shadow: 0 0 14px rgb(255, 42, 109);
}

.combo-badge {
    background-color: rgba(255, 42, 109, 0.2);
    border-color: rgb(255, 42, 109);
}

.combo-badge .icon-multiplier {
