.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
}

.safe-area-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.touch-guideline {
    position: absolute;
    bottom: 95px;
    align-self: center;
    width: 280px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(33, 212, 253, 0.15);
    border-width: 0;
    pointer-events: none;
    opacity: 0.16;
}

.top-bar {
    margin-top: 12px;
    margin-left: 0;
    margin-right: 0;
    height: 108px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    pointer-events: none;
    margin-bottom: 24px;
}

.hud-pod {
    height: 108px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(14, 18, 30, 0.78);
    border-radius: 28px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    pointer-events: auto;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
}

.lives-pod {
    padding-left: 12px;
    padding-right: 12px;
    justify-content: flex-start;
}

.lives-compact-pod {
    height: 108px;
    padding-left: 14px;
    padding-right: 16px;
    justify-content: center;
    align-items: center;
    border-color: rgba(255, 59, 86, 0.35);
    box-shadow: 0 0 14px rgba(255, 59, 86, 0.18);
    transition-property: scale;
    transition-duration: 0.12s;
}

.life-compact-heart {
    width: 64px;
    height: 64px;
    margin-right: 6px;
    background-image: url("project://database/Assets/UI/Icons/TX_Heart_Fill.png?fileID=21300000&guid=5c78b93fab88e17459882a82ea8a4a6f&type=3#TX_Heart_Fill");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 59, 86);
}

.lives-compact-text {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 1.2px;
    text-shadow: 0 0 8px rgba(255, 59, 86, 0.6);
}

.pause-pod {
    width: 108px;
    height: 108px;
    padding: 0;
    justify-content: center;
    align-items: center;
    border-radius: 28px;
    border-color: rgba(33, 212, 253, 0.3);
    box-shadow: 0 0 12px rgba(33, 212, 253, 0.18);
    transition-property: scale, border-color;
    transition-duration: 0.15s;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
}

.pause-pod:hover {
    scale: 1.08 1.08;
    border-color: rgb(33, 212, 253);
}

.pause-quick-btn {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    border-radius: 28px;
    margin: 0;
    padding: 0;
}

.score-pod {
    padding-left: 24px;
    padding-right: 24px;
    justify-content: center;
    align-items: center;
    border-color: rgba(33, 212, 253, 0.3);
    box-shadow: 0 0 12px rgba(33, 212, 253, 0.18);
    transition-property: scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out-back;
}

.score-pop {
    scale: 1.15 1.15;
}

.score-main {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(33, 212, 253);
    letter-spacing: 1.2px;
    margin: 0;
    text-shadow: 0 0 10px rgba(33, 212, 253, 0.55);
}

.score-sub {
    font-size: 14.5px;
    color: rgb(148, 163, 184);
    letter-spacing: 0.5px;
    margin: 0;
}

.lives-container {
    flex-direction: row;
    align-items: center;
}

.life-pip {
    width: 33px;
    height: 33px;
    margin: 0 4px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, -unity-background-image-tint-color, opacity;
    transition-duration: 0.25s, 0.25s, 0.25s;
    transition-timing-function: ease-out-back;
}

.pip-active {
    background-image: url("project://database/Assets/UI/Icons/TX_Heart_Fill.png?fileID=21300000&guid=5c78b93fab88e17459882a82ea8a4a6f&type=3#TX_Heart_Fill");
    -unity-background-image-tint-color: rgb(255, 59, 86);
    opacity: 1;
    scale: 1 1;
}

.pip-lost {
    background-image: url("project://database/Assets/UI/Icons/TX_Heart_Empty.png?fileID=21300000&guid=c9c893b5713e23449815fbcff6eb5834&type=3#TX_Heart_Empty");
    -unity-background-image-tint-color: rgb(255, 59, 86);
    opacity: 0.35;
    scale: 0.86 0.86;
}

.pip-hidden {
    display: none;
}

.pip-pop {
    scale: 1.45 1.45;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.flying-heart {
    position: absolute;
    width: 46px;
    height: 46px;
    background-image: url("project://database/Assets/UI/Icons/TX_Heart_Fill.png?fileID=21300000&guid=5c78b93fab88e17459882a82ea8a4a6f&type=3#TX_Heart_Fill");
    -unity-background-image-tint-color: rgb(255, 42, 109);
    -unity-background-scale-mode: scale-to-fit;
}

.powerup-status-container {
    margin-top: 16px;
    margin-left: 16px;
    margin-right: 16px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    margin-bottom: 16px;
}

.powerup-badge {
    height: 108px;
    flex-direction: row;
    align-items: center;
    padding: 0 18px;
    margin: 0 9px;
    border-radius: 24px;
    border-width: 1.5px;
    background-color: rgba(14, 18, 30, 0.9);
    transition-property: scale, opacity, translate;
    transition-duration: 0.25s, 0.25s, 0.25s;
    transition-timing-function: ease-out-back;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
}

.shield-badge {
    border-color: rgb(0, 242, 254);
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.65);
}

.multiball-badge {
    border-color: rgb(224, 86, 253);
    box-shadow: 0 0 12px rgba(224, 86, 253, 0.65);
}

.paddle-badge {
    border-color: rgb(0, 229, 255);
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.65);
}

.multiplier-badge {
    border-color: rgb(255, 215, 0);
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.65);
}

.mult-tier-2x {
    border-color: rgb(255, 215, 0);
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.75);
}

.mult-tier-3x {
    border-color: rgb(255, 140, 0);
    box-shadow: 0 0 12px rgba(255, 140, 0, 0.75);
}

.mult-tier-4x {
    border-color: rgb(255, 23, 68);
    box-shadow: 0 0 14px rgba(255, 23, 68, 0.85);
}

.mult-tier-5x {
    border-color: rgb(213, 0, 249);
    box-shadow: 0 0 14px rgba(213, 0, 249, 0.9);
}

.laser-badge {
    border-color: rgb(255, 42, 71);
    box-shadow: 0 0 14px rgba(255, 42, 71, 0.85);
}

.clutch-badge {
    border-color: rgb(255, 0, 127);
    box-shadow: 0 0 16px rgba(255, 0, 127, 0.9);
}

.powerup-status-icon {
    width: 64px;
    height: 64px;
    margin-right: 9px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-shield {
    -unity-background-image-tint-color: rgb(0, 242, 254);
}

.icon-multiball {
    -unity-background-image-tint-color: rgb(224, 86, 253);
}

.icon-paddle-expand {
    -unity-background-image-tint-color: rgb(0, 229, 255);
}

.icon-multiplier {
    -unity-background-image-tint-color: rgb(255, 215, 0);
}

.mult-tier-2x .icon-multiplier {
    -unity-background-image-tint-color: rgb(255, 215, 0);
}

.mult-tier-3x .icon-multiplier {
    -unity-background-image-tint-color: rgb(255, 140, 0);
}

.mult-tier-4x .icon-multiplier {
    -unity-background-image-tint-color: rgb(255, 23, 68);
}

.mult-tier-5x .icon-multiplier {
    -unity-background-image-tint-color: rgb(213, 0, 249);
}

.icon-laser {
    -unity-background-image-tint-color: rgb(255, 42, 71);
}

.powerup-timer-label {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}

.multiplier-val-text {
    font-size: 32px;
    -unity-font-style: bold;
    margin-right: 5px;
}

.clutch-val-text {
    font-size: 36px;
    -unity-font-style: bold;
    margin-right: 5px;
    color: rgb(255, 0, 127);
    text-shadow: 0 0 10px rgba(255, 0, 127, 0.9);
}

.shield-badge .powerup-timer-label {
    color: rgb(0, 242, 254);
    text-shadow: 0 0 8px rgba(0, 242, 254, 0.8);
}

.multiball-badge .powerup-timer-label {
    color: rgb(224, 86, 253);
    text-shadow: 0 0 8px rgba(224, 86, 253, 0.8);
}

.paddle-badge .powerup-timer-label {
    color: rgb(0, 229, 255);
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.8);
}

.laser-badge .powerup-timer-label {
    color: rgb(255, 42, 71);
    text-shadow: 0 0 8px rgba(255, 42, 71, 0.85);
}

.clutch-badge .powerup-timer-label {
    color: rgb(255, 255, 255);
    text-shadow: 0 0 8px rgba(255, 0, 127, 0.85);
}

.mult-tier-2x .multiplier-val-text,
.mult-tier-2x .powerup-timer-label {
    color: rgb(255, 215, 0);
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.8);
}

.mult-tier-3x .multiplier-val-text,
.mult-tier-3x .powerup-timer-label {
    color: rgb(255, 140, 0);
    text-shadow: 0 0 8px rgba(255, 140, 0, 0.8);
}

.mult-tier-4x .multiplier-val-text,
.mult-tier-4x .powerup-timer-label {
    color: rgb(255, 23, 68);
    text-shadow: 0 0 8px rgba(255, 23, 68, 0.8);
}

.mult-tier-5x .multiplier-val-text,
.mult-tier-5x .powerup-timer-label {
    color: rgb(213, 0, 249);
    text-shadow: 0 0 8px rgba(213, 0, 249, 0.8);
}

.powerdown-badge {
    border-color: rgb(255, 23, 68);
    box-shadow: 0 0 14px rgba(255, 23, 68, 0.95);
    background-color: rgba(30, 10, 14, 0.92);
}

.powerdown-badge .powerup-timer-label,
.powerdown-timer-label {
    color: rgb(255, 23, 68);
    text-shadow: 0 0 10px rgba(255, 23, 68, 0.95);
}

.powerdown-badge .powerup-status-icon {
    -unity-background-image-tint-color: rgb(255, 23, 68);
}

.icon-paddle-shrink {
    background-image: url("project://database/Assets/UI/Icons/TX_Powerdown_Arrows_Inward.png?fileID=21300000&guid=6ebcd1fa1b3d001468147f32590c82ca&type=3#TX_Powerdown_Arrows_Inward");
}

.icon-paddle-slow {
    background-image: url("project://database/Assets/UI/Icons/TX_Powerdown_Slower_Paddle.png?fileID=21300000&guid=3f526f475d1500f468a096116384b160&type=3#TX_Powerdown_Slower_Paddle");
}

.icon-ball-shrink {
    background-image: url("project://database/Assets/UI/Icons/TX_Powerdown_Smaller_Ball.png?fileID=21300000&guid=d41c63e0db548c14296c560508e963a9&type=3#TX_Powerdown_Smaller_Ball");
}

.icon-ball-slow {
    background-image: url("project://database/Assets/UI/Icons/TX_Powerdown_Slower_Ball.png?fileID=21300000&guid=62d7230a48b7706468a7d6c48b12b01e&type=3#TX_Powerdown_Slower_Ball");
}

.icon-paddle-freeze {
    background-image: url("project://database/Assets/UI/Icons/TX_Powerdown_Frozen_Paddle.png?fileID=21300000&guid=5c5ea66d3fadd934592fd49d80b0f741&type=3#TX_Powerdown_Frozen_Paddle");
}

.paddle-shrink-badge {
    border-color: rgb(255, 23, 68);
}

.paddle-slow-badge {
    border-color: rgb(255, 56, 96);
}

.ball-shrink-badge {
    border-color: rgb(255, 23, 68);
}

.ball-slow-badge {
    border-color: rgb(255, 56, 96);
}

.paddle-freeze-badge {
    border-color: rgb(255, 23, 68);
    box-shadow: 0 0 16px rgba(255, 23, 68, 0.95);
}

.powerup-hidden {
    display: none;
    opacity: 0;
    scale: 0.8 0.8;
}

.quick-controls {
    flex-direction: row;
    align-items: center;
}

.controls-pod {
    padding-left: 8px;
    padding-right: 8px;
    justify-content: flex-end;
    align-items: center;
}

.quick-btn {
    width: 100%;
    height: 100%;
    margin-left: 0;
    margin-right: 0;
    border-radius: 22px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.14);
    color: rgb(226, 232, 240);
    font-size: 20px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    margin-top: 0;
    margin-bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.quick-btn:hover {
    background-color: rgba(33, 212, 253, 0.2);
    border-color: rgba(33, 212, 253, 0.75);
    scale: 1.14 1.14;
    translate: 0 -1px;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.quick-btn:active {
    background-color: rgba(255, 255, 255, 0.04);
    scale: 0.88 0.88;
    translate: 0 1px;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

.quick-btn-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(226, 232, 240);
    transition-property: rotate, scale, -unity-background-image-tint-color;
    transition-duration: 0.5s, 0.2s, 0.2s;
    transition-timing-function: ease-out-back;
}

.quick-btn:hover .quick-btn-icon {
    -unity-background-image-tint-color: rgb(33, 212, 253);
}

.quick-btn:hover .icon-volume-up {
    -unity-background-image-tint-color: rgb(255, 110, 130);
}

.quick-btn:hover .icon-play {
    -unity-background-image-tint-color: rgb(110, 245, 178);
}

.icon-level-settings {
    background-image: url("project://database/Assets/UI/Icons/TX_Level_Settings.png?fileID=21300000&guid=31f75bf5242ae5841843e322927f8164&type=3#TX_Level_Settings");
}

.icon-volume-mute {
    background-image: url("project://database/Assets/UI/Icons/TX_Volume_Mute.png?fileID=21300000&guid=19323d3393a6acb4c9810de7a485552e&type=3#TX_Volume_Mute");
}

.icon-volume-up {
    background-image: url("project://database/Assets/UI/Icons/TX_Volume_Up.png?fileID=21300000&guid=9b70a43178d3e484aaa75e906b4ade94&type=3#TX_Volume_Up");
    -unity-background-image-tint-color: rgb(255, 59, 86);
}

.icon-settings {
    background-image: url("project://database/Assets/UI/Icons/TX_Settings.png?fileID=21300000&guid=d24cd8b25486cfe45a7731b9a5d3afce&type=3#TX_Settings");
}

.icon-pause {
    background-image: url("project://database/Assets/UI/Icons/TX_Pause.png?fileID=21300000&guid=de14abab37824164b93573467f215b5c&type=3#TX_Pause");
}

.icon-play {
    background-image: url("project://database/Assets/UI/Icons/TX_Play.png?fileID=21300000&guid=dd600ea38ce338d4394fa625707eaee8&type=3#TX_Play");
    -unity-background-image-tint-color: rgb(38, 232, 133);
}

.launch-banner {
    position: absolute;
    bottom: 22%;
    align-self: center;
    flex-direction: row;
    align-items: center;
    background-color: rgba(14, 20, 36, 0.88);
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.55);
    border-radius: 24px;
    padding: 10px 22px;
    box-shadow: 0 0 16px rgba(33, 212, 253, 0.25);
    pointer-events: none;
    transition-property: scale, opacity;
    transition-duration: 0.25s;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.launch-banner-hidden {
    display: none;
    opacity: 0;
    scale: 0.8 0.8;
}

.launch-arrow-left {
    width: 64px;
    height: 64px;
    margin-right: 8px;
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_Arrow_Left.png?fileID=21300000&guid=a8825fa6e09212041956a6ff878e0074&type=3#TX_Icon_Arrow_Left");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(33, 212, 253);
}

.launch-finger-icon {
    width: 64px;
    height: 64px;
    margin-right: 8px;
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_Finger.png?fileID=21300000&guid=c1e43c38002c30947a94159bae08bf2b&type=3#TX_Icon_Finger");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.launch-arrow-right {
    width: 64px;
    height: 64px;
    margin-right: 12px;
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_Arrow_Right.png?fileID=21300000&guid=790e375755a510b4aa7f9e846be910c8&type=3#TX_Icon_Arrow_Right");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(33, 212, 253);
}

.launch-text {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(33, 212, 253);
    letter-spacing: 1.5px;
    text-shadow: 0 0 10px rgba(33, 212, 253, 0.8);
}

.level-clear-banner {
    position: absolute;
    top: 36%;
    align-self: center;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 14, 26, 0.92);
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.85);
    border-radius: 22px;
    padding: 18px 44px;
    pointer-events: none;
    transition-property: scale, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
    scale: 1 1;
    opacity: 1;
}

.level-clear-banner-hidden {
    display: none;
    scale: 0.7 0.7;
    opacity: 0;
}

.level-clear-banner-text {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 215, 0);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 16px rgba(255, 215, 0, 0.9);
    margin-bottom: 4px;
}

.level-clear-banner-subtext {
