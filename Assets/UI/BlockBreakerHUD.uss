.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    pointer-events: none; /* Let gameplay clicks pass through background */
}

/* Top Bar */
.top-bar {
    position: absolute;
    top: 14px;
    left: 20px;
    right: 20px;
    height: 60px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(14, 18, 30, 0.75);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 0 18px;
    pointer-events: auto;
}

.score-container {
    justify-content: center;
}

.score-main {
    font-size: 18px;
    -unity-font-style: bold;
    color: #21d4fd;
    letter-spacing: 1px;
    margin: 0;
}

.score-sub {
    font-size: 11px;
    color: #94a3b8;
    letter-spacing: 0.5px;
    margin: 0;
}

/* Lives Pips */
.lives-container {
    flex-direction: row;
    align-items: center;
}

.life-pip {
    width: 22px;
    height: 22px;
    margin: 0 4px;
    border-radius: 11px;
    border-width: 2px;
    border-color: #ff3b56;
    transition-duration: 0.2s;
}

.pip-active {
    background-color: #ff3b56;
    box-shadow: 0 0 10px rgba(255, 59, 86, 0.7);
}

.pip-lost {
    background-color: rgba(255, 59, 86, 0.15);
    border-color: rgba(255, 59, 86, 0.3);
    scale: 0.85;
}

/* Subtle Quick Control Buttons */
.quick-controls {
    flex-direction: row;
    align-items: center;
}

.quick-btn {
    width: 38px;
    height: 38px;
    margin-left: 8px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    font-size: 15px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.12s;
}

.quick-btn:hover {
    background-color: rgba(255, 255, 255, 0.18);
    scale: 1.05;
}

.quick-btn:active {
    background-color: rgba(255, 255, 255, 0.05);
    scale: 0.95;
}

/* Launch Banner */
.launch-banner {
    position: absolute;
    bottom: 120px;
    align-self: center;
    background-color: rgba(33, 212, 253, 0.15);
    border-width: 1px;
    border-color: rgba(33, 212, 253, 0.4);
    border-radius: 16px;
    padding: 10px 24px;
}

.launch-banner-hidden {
    display: none;
}

.launch-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    text-shadow: 0 0 8px rgba(33, 212, 253, 0.8);
}

/* Modals */
.modal-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 10, 18, 0.85);
    align-items: center;
    justify-content: center;
    pointer-events: auto;
}

.modal-hidden {
    display: none;
}

.modal-card {
    width: 350px;
    background-color: #171c2c;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 28px 22px;
    align-items: stretch;
}

.victory-card {
    border-color: rgba(38, 232, 133, 0.4);
}

.gameover-card {
    border-color: rgba(255, 59, 86, 0.4);
}

.modal-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    align-self: center;
    margin-bottom: 12px;
}

.victory-title {
    color: #26e885;
    text-shadow: 0 0 15px rgba(38, 232, 133, 0.6);
}

.gameover-title {
    color: #ff3b56;
    text-shadow: 0 0 15px rgba(255, 59, 86, 0.6);
}

.modal-score {
    font-size: 18px;
    -unity-font-style: bold;
    color: #21d4fd;
    align-self: center;
    margin-bottom: 4px;
}

.modal-subscore {
    font-size: 13px;
    color: #94a3b8;
    align-self: center;
    margin-bottom: 18px;
}

.arcade-btn {
    height: 48px;
    border-radius: 14px;
    border-width: 1px;
    margin-top: 10px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-duration: 0.15s;
    align-items: center;
    justify-content: center;
}

.btn-primary {
    background-color: #ff3b56;
    border-color: #ff6e82;
    color: #ffffff;
}

.btn-primary:hover {
    background-color: #ff546c;
    scale: 1.02;
}

.btn-primary:active {
    background-color: #e02844;
    scale: 0.98;
}

.btn-secondary {
    background-color: #26e885;
    border-color: #6ef5b2;
    color: #0c0d16;
}

.btn-secondary:hover {
    background-color: #49f39d;
    scale: 1.02;
}

.btn-secondary:active {
    background-color: #17be67;
    scale: 0.98;
}

.btn-default {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
}

.btn-default:hover {
    background-color: rgba(255, 255, 255, 0.14);
    scale: 1.02;
}

.btn-default:active {
    background-color: rgba(255, 255, 255, 0.05);
    scale: 0.98;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.setting-label {
    font-size: 14px;
    color: #cbd5e1;
}

.setting-slider {
    width: 140px;
}

.fps-btn {
    width: 85px;
    height: 32px;
    border-radius: 8px;
    background-color: #252e46;
    border-color: rgba(255, 255, 255, 0.2);
    color: #21d4fd;
    -unity-font-style: bold;
    font-size: 12px;
}

.modal-close-btn {
    margin-top: 16px;
}
