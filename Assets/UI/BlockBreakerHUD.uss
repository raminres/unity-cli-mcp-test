}

.combo-badge.mult-tier-5x .combo-val-text {
    color: rgb(213, 0, 249);
    text-shadow: 0 0 8px rgba(213, 0, 249, 0.8);
}

.scorecard-card {
    width: 840px;
    background-color: rgb(21, 25, 40);
    border-radius: 28px;
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.4);
    padding: 28px 24px;
    align-items: center;
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    margin-top: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    margin-left: 16px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
