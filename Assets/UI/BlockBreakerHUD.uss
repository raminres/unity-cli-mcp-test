.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    pointer-events: none; /* Let gameplay clicks pass through background */
}

/* Top Bar */
.top-bar {
    margin-top: 14px;
    margin-left: 18px;
    margin-right: 18px;
    height: 64px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(14, 18, 30, 0.88);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 0 20px;
    pointer-events: auto;
}

.score-container {
    justify-content: center;
}

.score-main {
    font-size: 20px;
    -unity-font-style: bold;
    color: #21d4fd;
    letter-spacing: 1px;
    margin: 0;
}

.score-sub {
    font-size: 13px;
    color: #94a3b8;
    letter-spacing: 0.5px;
    margin: 0;
}

/* Lives Pips */
.lives-container {
    flex-direction: row;
    align-items: center;
}

.life-pip {
    width: 24px;
    height: 24px;
    margin: 0 4px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #ff3b56;
    transition-duration: 0.2s;
}

.pip-active {
    background-color: #ff3b56;
    box-shadow: 0 0 12px rgba(255, 59, 86, 0.8);
}

.pip-lost {
    background-color: rgba(255, 59, 86, 0.15);
    border-color: rgba(255, 59, 86, 0.3);
    scale: 0.82;
}

/* Bouncy Quick Control Buttons */
.quick-controls {
    flex-direction: row;
    align-items: center;
}

.quick-btn {
    width: 46px;
    height: 46px;
    margin-left: 8px;
    border-radius: 14px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    font-size: 20px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color, translate;
    transition-duration: 0.25s, 0.15s, 0.15s, 0.25s;
    transition-timing-function: ease-out-back;
}

.quick-btn:hover {
    background-color: rgba(255, 255, 255, 0.24);
    border-color: rgba(33, 212, 253, 0.7);
    scale: 1.15 1.15;
    translate: 0 -2px;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.quick-btn:active {
    background-color: rgba(255, 255, 255, 0.06);
    scale: 0.86 0.86;
    translate: 0 2px;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

/* Launch Banner */
.launch-banner {
    position: absolute;
    bottom: 130px;
    align-self: center;
    background-color: rgba(33, 212, 253, 0.15);
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.45);
    border-radius: 18px;
    padding: 12px 28px;
}

.launch-banner-hidden {
    display: none;
}

.launch-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    text-shadow: 0 0 10px rgba(33, 212, 253, 0.8);
}

/* Modals */
.modal-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 10, 18, 0.85);
    align-items: center;
    justify-content: center;
    pointer-events: auto;
}

.modal-hidden {
    display: none;
}

.modal-card {
    width: 360px;
    background-color: #171c2c;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 28px 24px;
    align-items: stretch;
}

.victory-card {
    border-color: rgba(38, 232, 133, 0.4);
}

.gameover-card {
    border-color: rgba(255, 59, 86, 0.4);
}

.modal-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    align-self: center;
    margin-bottom: 14px;
}

.victory-title {
    color: #26e885;
    text-shadow: 0 0 15px rgba(38, 232, 133, 0.6);
}

.gameover-title {
    color: #ff3b56;
    text-shadow: 0 0 15px rgba(255, 59, 86, 0.6);
}

.modal-score {
    font-size: 20px;
    -unity-font-style: bold;
    color: #21d4fd;
    align-self: center;
    margin-bottom: 4px;
}

.modal-subscore {
    font-size: 14px;
    color: #94a3b8;
    align-self: center;
    margin-bottom: 20px;
}

/* Bouncy Modal Arcade Buttons */
.arcade-btn {
    height: 54px;
    border-radius: 16px;
    border-width: 1.5px;
    margin-top: 12px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color, translate;
    transition-duration: 0.25s, 0.15s, 0.15s, 0.25s;
    transition-timing-function: ease-out-back;
}

.arcade-btn:hover {
    scale: 1.05 1.05;
    translate: 0 -2px;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.arcade-btn:active {
    scale: 0.92 0.92;
    translate: 0 3px;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

.btn-primary {
    background-color: #ff3b56;
    border-color: #ff6e82;
    color: #ffffff;
}

.btn-primary:hover {
    background-color: #ff546c;
    border-color: #ffffff;
}

.btn-primary:active {
    background-color: #d81e3a;
    border-color: #ff3b56;
}

.btn-secondary {
    background-color: #26e885;
    border-color: #6ef5b2;
    color: #0c0d16;
}

.btn-secondary:hover {
    background-color: #4df7a1;
    border-color: #ffffff;
}

.btn-secondary:active {
    background-color: #17be67;
    border-color: #26e885;
}

.btn-default {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
}

.btn-default:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
}

.btn-default:active {
    background-color: rgba(255, 255, 255, 0.04);
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.setting-label {
    font-size: 15px;
    color: #cbd5e1;
}

.setting-slider {
    width: 150px;
}

.fps-btn {
    width: 95px;
    height: 36px;
    border-radius: 10px;
    background-color: #252e46;
    border-color: rgba(255, 255, 255, 0.2);
    color: #21d4fd;
    -unity-font-style: bold;
    font-size: 14px;
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.fps-btn:hover {
    scale: 1.08 1.08;
    background-color: #2e3a58;
    transition-timing-function: ease-out-back;
}

.fps-btn:active {
    scale: 0.92 0.92;
    transition-duration: 0.08s;
}

.modal-close-btn {
    margin-top: 16px;
}

/* Level Settings Modal Extensions */
.modal-card-wide {
    width: 440px;
}

.level-tabs-container {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.level-tab-btn {
    flex-grow: 1;
    height: 38px;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s, 0.15s, 0.15s;
    transition-timing-function: ease-out-back;
}

.level-tab-btn:hover {
    scale: 1.05 1.05;
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(33, 212, 253, 0.6);
}

.level-tab-btn:active {
    scale: 0.94 0.94;
}

.level-tab-active {
    background-color: #21d4fd;
    border-color: #21d4fd;
    color: #0c0d16;
}

.level-tab-active:hover {
    background-color: #55ddfe;
    border-color: #55ddfe;
    color: #0c0d16;
}

.level-name-display {
    font-size: 18px;
    -unity-font-style: bold;
    color: #21d4fd;
    align-self: center;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.level-desc-display {
    font-size: 12px;
    color: #94a3b8;
    align-self: center;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.setting-val-badge {
    width: 64px;
    font-size: 14px;
    -unity-font-style: bold;
    color: #21d4fd;
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.modal-action-btn {
    margin-top: 14px;
}
