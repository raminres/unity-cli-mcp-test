<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="MainMenuUI.uss" />
    <ui:VisualElement name="root-container" class="root-container">
        <!-- Ambient background gradient & glowing orbs -->
        <ui:VisualElement name="bg-glow" class="bg-glow" />

        <!-- Title Section -->
        <ui:VisualElement name="header-container" class="header-container">
            <ui:Label text="BLOCK" class="game-title title-highlight" />
            <ui:Label text="BREAKER" class="game-title title-main" />
            <ui:Label text="3D ARCADE RETRO-MODERN" class="subtitle" />
        </ui:VisualElement>

        <!-- Main Buttons Container -->
        <ui:VisualElement name="menu-card" class="menu-card">
            <ui:Button name="btn-new-game" text="START NEW GAME" class="arcade-button primary-btn" />
            <ui:Button name="btn-level-select" text="SELECT LEVEL" class="arcade-button secondary-btn" />
            <ui:Button name="btn-continue" text="CONTINUE" class="arcade-button default-btn" />
            <ui:Button name="btn-highscores" text="HIGH SCORES" class="arcade-button default-btn" />
            <ui:Button name="btn-how-to-play" text="HOW TO PLAY" class="arcade-button default-btn" />
            <ui:Button name="btn-options" text="OPTIONS" class="arcade-button default-btn" />
            <ui:Button name="btn-credits" text="CREDITS" class="arcade-button default-btn" />
        </ui:VisualElement>

        <!-- Level Select Modal (Hidden by default) -->
        <ui:VisualElement name="level-modal" class="modal-backdrop modal-hidden">
            <ui:VisualElement class="modal-card modal-card-wide">
                <ui:Label text="SELECT LEVEL" class="modal-title" />

                <!-- Level Tabs -->
                <ui:VisualElement class="level-tabs-container">
                    <ui:Button name="btn-menu-lvl-1" text="LVL 1" class="level-tab-btn level-tab-active" />
                    <ui:Button name="btn-menu-lvl-2" text="LVL 2" class="level-tab-btn" />
                    <ui:Button name="btn-menu-lvl-3" text="LVL 3" class="level-tab-btn" />
                    <ui:Button name="btn-menu-lvl-4" text="LVL 4" class="level-tab-btn" />
                    <ui:Button name="btn-menu-lvl-5" text="LVL 5" class="level-tab-btn" />
                    <ui:Button name="btn-menu-lvl-6" text="LVL 6" class="level-tab-btn" />
                    <ui:Button name="btn-menu-lvl-7" text="LVL 7" class="level-tab-btn" />
                </ui:VisualElement>

                <ui:Label name="menu-level-name" text="Level 1: Classic Inverted" class="level-name-display" />
                <ui:Label name="menu-level-desc" text="Classic 3-tier block setup with Red on bottom, Green in middle, and Blue on top. Features random x2 multiplier and paddle expander blocks." class="level-desc-display" />

                <ui:Button name="btn-start-selected-level" text="PLAY LEVEL" class="arcade-button primary-btn modal-action-btn" />
                <ui:Button name="btn-close-level-modal" text="BACK" class="arcade-button default-btn modal-close-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- High Scores Modal (Top 10 Leaderboard) -->
        <ui:VisualElement name="highscores-modal" class="modal-backdrop modal-hidden">
            <ui:VisualElement class="modal-card modal-card-wide leaderboard-card">
                <ui:Label text="HIGH SCORES" class="modal-title" />
                <ui:VisualElement class="leaderboard-table">
                    <!-- Row 1: Gold -->
                    <ui:VisualElement class="score-row row-gold">
                        <ui:VisualElement class="rank-badge-pod">
                            <ui:VisualElement class="medal-icon icon-gold" />
                            <ui:Label text="1st" class="rank-label label-gold" />
                        </ui:VisualElement>
                        <ui:Label name="score-val-0" text="---" class="score-row-value val-gold" />
                        <ui:Label name="score-date-0" text="---" class="score-row-date" />
                    </ui:VisualElement>

                    <!-- Row 2: Silver -->
                    <ui:VisualElement class="score-row row-silver">
                        <ui:VisualElement class="rank-badge-pod">
                            <ui:VisualElement class="medal-icon icon-silver" />
                            <ui:Label text="2nd" class="rank-label label-silver" />
                        </ui:VisualElement>
                        <ui:Label name="score-val-1" text="---" class="score-row-value val-silver" />
                        <ui:Label name="score-date-1" text="---" class="score-row-date" />
                    </ui:VisualElement>

                    <!-- Row 3: Bronze -->
                    <ui:VisualElement class="score-row row-bronze">
                        <ui:VisualElement class="rank-badge-pod">
                            <ui:VisualElement class="medal-icon icon-bronze" />
                            <ui:Label text="3rd" class="rank-label label-bronze" />
                        </ui:VisualElement>
                        <ui:Label name="score-val-2" text="---" class="score-row-value val-bronze" />
                        <ui:Label name="score-date-2" text="---" class="score-row-date" />
                    </ui:VisualElement>

                    <!-- Rows 4 to 10 -->
                    <ui:VisualElement class="score-row">
                        <ui:Label text="#4" class="rank-num-label" />
                        <ui:Label name="score-val-3" text="---" class="score-row-value" />
                        <ui:Label name="score-date-3" text="---" class="score-row-date" />
                    </ui:VisualElement>
                    <ui:VisualElement class="score-row">
                        <ui:Label text="#5" class="rank-num-label" />
                        <ui:Label name="score-val-4" text="---" class="score-row-value" />
                        <ui:Label name="score-date-4" text="---" class="score-row-date" />
                    </ui:VisualElement>
                    <ui:VisualElement class="score-row">
                        <ui:Label text="#6" class="rank-num-label" />
                        <ui:Label name="score-val-5" text="---" class="score-row-value" />
                        <ui:Label name="score-date-5" text="---" class="score-row-date" />
                    </ui:VisualElement>
                    <ui:VisualElement class="score-row">
                        <ui:Label text="#7" class="rank-num-label" />
                        <ui:Label name="score-val-6" text="---" class="score-row-value" />
                        <ui:Label name="score-date-6" text="---" class="score-row-date" />
                    </ui:VisualElement>
                    <ui:VisualElement class="score-row">
                        <ui:Label text="#8" class="rank-num-label" />
                        <ui:Label name="score-val-7" text="---" class="score-row-value" />
                        <ui:Label name="score-date-7" text="---" class="score-row-date" />
                    </ui:VisualElement>
                    <ui:VisualElement class="score-row">
                        <ui:Label text="#9" class="rank-num-label" />
                        <ui:Label name="score-val-8" text="---" class="score-row-value" />
                        <ui:Label name="score-date-8" text="---" class="score-row-date" />
                    </ui:VisualElement>
                    <ui:VisualElement class="score-row">
                        <ui:Label text="#10" class="rank-num-label" />
                        <ui:Label name="score-val-9" text="---" class="score-row-value" />
                        <ui:Label name="score-date-9" text="---" class="score-row-date" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button name="btn-reset-highscores" text="RESET SCORES" class="arcade-button warning-btn modal-action-btn" />
                <ui:Button name="btn-close-highscores" text="BACK" class="arcade-button default-btn modal-close-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- How To Play Modal -->
        <ui:VisualElement name="how-to-play-modal" class="modal-backdrop modal-hidden">
            <ui:VisualElement class="modal-card modal-card-wide how-to-play-card">
                <ui:Label text="HOW TO PLAY" class="modal-title" />
                <ui:ScrollView class="guide-scroll">
                    <ui:VisualElement class="guide-card">
                        <ui:Label text="1. CONTROLS &amp; LAUNCH" class="guide-heading" />
                        <ui:Label text="• Drag touch or mouse horizontally to guide the paddle.&#10;• Keyboard: A/D or Left/Right arrows.&#10;• Tap screen, click, or press Up/Space to launch." class="guide-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="guide-card">
                        <ui:Label text="2. DYNAMIC PADDLE DEFLECTION" class="guide-heading" />
                        <ui:Label text="• Rebounds calculate angle from hit offset! Center bounces vertical (90°); outer edges yield sharp angles (30°) for surgical precision." class="guide-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="guide-card">
                        <ui:Label text="3. SCORING &amp; GLASS BRICKS" class="guide-heading" />
                        <ui:Label text="• Red = 10 pts • Green = 20 pts • Blue = 30 pts.&#10;• Glass Bricks require 2 hits: Hit 1 shatters the protective shell; Hit 2 breaks the brick for 2x points!" class="guide-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="guide-card">
                        <ui:Label text="4. POWERUPS &amp; HAZARDS" class="guide-heading" />
                        <ui:Label text="• Expander: Widens paddle by +10%.&#10;• Multipliers: 2X and 3X bonus points per block.&#10;• Shield: Kinetic barrier protects for 10s.&#10;• Multi-Ball: 3 balls! Extra balls don't lose lives.&#10;• Bombs: Radial detonation explodes neighbors!&#10;• Extra Heart: Grants +1 life (up to 5 max)." class="guide-text" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Button name="btn-close-how-to-play" text="BACK" class="arcade-button primary-btn modal-close-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Options Modal (Hidden by default) -->
        <ui:VisualElement name="options-modal" class="modal-backdrop modal-hidden">
            <ui:VisualElement class="modal-card">
                <ui:Label text="SETTINGS" class="modal-title" />
                
                <ui:VisualElement class="setting-row">
                    <ui:Label text="SFX Volume" class="setting-label" />
                    <ui:Slider name="slider-volume" low-value="0" high-value="1" value="0.8" class="setting-slider" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="Mute SFX" class="setting-label" />
                    <ui:Toggle name="toggle-mute" class="setting-toggle" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="Target Frame Rate" class="setting-label" />
                    <ui:Button name="btn-toggle-fps" text="60 FPS" class="fps-btn" />
                </ui:VisualElement>

                <ui:Button name="btn-close-options" text="BACK" class="arcade-button primary-btn modal-close-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Credits Modal (Hidden by default) -->
        <ui:VisualElement name="credits-modal" class="modal-backdrop modal-hidden">
            <ui:VisualElement class="modal-card modal-card-wide credits-card">
                <ui:Label text="CREDITS" class="modal-title" />
                <ui:Label text="BLOCK BREAKER" class="credit-highlight" />
                <ui:Label text="Engineered with Unity MCP • Gemini • Antigravity" class="credit-body credit-bold" />
                <ui:Label text="Developed by Ramin Rasulzade" class="credit-author" />

                <!-- Interactive Clickable Links -->
                <ui:VisualElement class="credit-links-container">
                    <ui:Button name="btn-credit-email" text="✉  ramin.rasulzade@gmail.com" class="credit-link-btn" />
                    <ui:Button name="btn-credit-website" text="🌐  raminrasulzade.com" class="credit-link-btn" />
                    <ui:Button name="btn-credit-linkedin" text="🔗  linkedin.com/in/ramin-rasulzade" class="credit-link-btn" />
                    <ui:Button name="btn-credit-github" text="🐙  github.com/raminres" class="credit-link-btn" />
                </ui:VisualElement>

                <ui:Label text="Unity 6000.6 (URP) • Apple Metal • WebGPU" class="credit-footnote" />
                <ui:Button name="btn-close-credits" text="BACK" class="arcade-button primary-btn modal-close-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
