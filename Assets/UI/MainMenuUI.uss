.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    padding: 0;
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
}

.main-menu-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.header-container {
    align-items: center;
    margin-bottom: 40px;
}

.game-title {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 62px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin: 0;
    padding: 0;
}

.title-highlight {
    color: rgb(255, 59, 86);
    text-shadow: 0 0 15px rgba(255, 59, 86, 0.6);
}

.title-main {
    color: rgb(33, 212, 253);
    text-shadow: 0 0 15px rgba(33, 212, 253, 0.6);
    margin-top: -10px;
}

.subtitle {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 48px;
    color: rgb(143, 160, 192);
    letter-spacing: 3px;
    margin-top: 8px;
}

.menu-card {
    width: 840px;
    background-color: rgba(22, 28, 44, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 28px;
    padding: 28px 24px;
    align-items: stretch;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.arcade-button {
    height: 128px;
    border-radius: 18px;
    border-width: 1.5px;
    margin-bottom: 16px;
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color, translate;
    transition-duration: 0.25s, 0.15s, 0.15s, 0.25s;
    transition-timing-function: ease-out-back;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    margin-top: 16px;
    margin-right: 16px;
    margin-left: 16px;
}

.arcade-button:hover {
    scale: 1.05 1.05;
    translate: 0 -2px;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.arcade-button:active {
    scale: 0.92 0.92;
    translate: 0 3px;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

.primary-btn {
    background-color: rgb(255, 59, 86);
    border-color: rgb(255, 110, 130);
    color: rgb(255, 255, 255);
}

.primary-btn:hover {
    background-color: rgb(255, 84, 108);
    border-color: rgb(255, 255, 255);
}

.primary-btn:active {
    background-color: rgb(216, 30, 58);
    border-color: rgb(255, 59, 86);
}

.secondary-btn {
    background-color: rgb(33, 212, 253);
    border-color: rgb(110, 227, 255);
    color: rgb(12, 13, 22);
}

.secondary-btn:hover {
    background-color: rgb(85, 227, 255);
    border-color: rgb(255, 255, 255);
}

.secondary-btn:active {
    background-color: rgb(11, 181, 220);
    border-color: rgb(33, 212, 253);
}

.default-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: rgb(226, 232, 240);
}

.default-btn:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
}

.default-btn:active {
    background-color: rgba(255, 255, 255, 0.04);
}

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(4, 6, 14, 0.94);
    align-items: center;
    justify-content: center;
}

.unity-scroller #unity-low-button,
.unity-scroller #unity-high-button {
    display: none;
    width: 0;
    height: 0;
}

.unity-scroller--vertical {
    width: 8px;
    margin-right: 2px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(33, 212, 253, 0.55);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(33, 212, 253);
}

.modal-hidden {
    display: none;
}

.modal-card {
    width: 840px;
    background-color: rgb(23, 28, 44);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 28px;
    padding: 32px 28px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.modal-title {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    align-self: center;
    margin-bottom: 18px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.setting-label {
    font-size: 32px;
    color: rgb(203, 213, 225);
}

.setting-slider {
    width: 210px;
    height: 64px;
}

.fps-btn {
    width: 160px;
    height: 108px;
    border-radius: 12px;
    background-color: rgb(37, 46, 70);
    border-color: rgba(255, 255, 255, 0.2);
    color: rgb(33, 212, 253);
    -unity-font-style: bold;
    font-size: 24px;
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.fps-btn:hover {
    scale: 1.08 1.08;
    background-color: rgb(46, 58, 88);
    transition-timing-function: ease-out-back;
}

.fps-btn:active {
    scale: 0.92 0.92;
    transition-duration: 0.08s;
}

.modal-close-btn {
    margin-top: 16px;
    margin-bottom: 0;
}

.credit-highlight {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(33, 212, 253);
    margin-bottom: 12px;
    align-self: center;
}

.credit-body {
    font-size: 24px;
    color: rgb(148, 163, 184);
    margin-bottom: 7px;
    align-self: center;
}

.modal-card-wide {
    width: 640px;
}

.level-modal-card {
    width: 840px;
    max-height: 94%;
    background-color: rgb(13, 18, 34);
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.45);
    border-radius: 30px;
    padding: 24px 20px 20px 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.level-modal-title {
    font-size: 52px;
    color: rgb(255, 255, 255);
    letter-spacing: 3px;
    margin-bottom: 2px;
    align-self: center;
}

.level-modal-subtitle {
    font-size: 32px;
    color: rgb(126, 143, 168);
    margin-bottom: 8px;
    align-self: center;
}

.cyan-pill-divider {
    width: 100%;
    height: 3px;
    background-color: rgb(33, 212, 253);
    border-radius: 2px;
    align-self: center;
    margin-bottom: 14px;
    box-shadow: 0 0 8px rgb(33, 212, 253);
}

.level-grid-scroll-view {
    height: 540px;
    margin-bottom: 12px;
}

.level-grid-scroll-view #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.level-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

.level-grid-card {
    width: 240px;
    height: 200px;
    margin-bottom: 16px;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.28);
    background-color: rgba(18, 25, 45, 0.85);
    align-items: center;
    justify-content: center;
    padding: 4px;
    transition-property: scale, border-color, box-shadow, background-color;
    transition-duration: 0.18s;
    margin-top: 16px;
    margin-right: 8px;
    margin-left: 8px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.level-grid-card:hover {
    scale: 1.05 1.05;
    border-color: rgb(33, 212, 253);
    background-color: rgba(26, 36, 64, 0.95);
}

.level-card-selected {
    border-color: rgb(255, 59, 141);
    background-color: rgba(33, 212, 253, 0.12);
    box-shadow: 0 0 18px rgba(255, 59, 141, 0.55), inset 0 0 10px rgba(33, 212, 253, 0.25);
    scale: 1.04 1.04;
}

.level-card-num {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 2px;
}

.level-card-stars-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
}

.card-star {
    font-size: 13px;
    margin: 0 1px;
}

.star-active {
    color: rgb(255, 215, 0);
}

.star-inactive {
    color: rgba(148, 163, 184, 0.3);
}

.level-card-time {
    font-size: 20px;
    color: rgb(126, 143, 168);
    -unity-font-style: bold;
}

.level-card-locked {
    opacity: 0.55;
    border-color: rgba(255, 255, 255, 0.12);
}

.level-card-lock-icon {
    font-size: 18px;
    color: rgb(126, 143, 168);
    margin-bottom: 2px;
}

.level-card-locked-label {
    font-size: 10px;
    color: rgb(100, 116, 139);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.level-preview-card {
    width: 100%;
    min-height: 140px;
    flex-direction: row;
    background-color: rgba(10, 15, 28, 0.98);
    border-width: 1px;
    border-color: rgba(33, 212, 253, 0.3);
    border-radius: 18px;
    padding: 10px 12px;
    margin-bottom: 12px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.level-preview-thumb {
    width: 160px;
    height: 320px;
    border-radius: 12px;
    background-color: rgba(6, 9, 18, 0.9);
    border-width: 1px;
    border-color: rgba(255, 59, 141, 0.35);
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.preview-details {
    flex-grow: 1;
    flex-direction: column;
}

.preview-level-tag {
    font-size: 20px;
    letter-spacing: 1.5px;
    color: rgb(126, 143, 168);
    -unity-font-style: bold;
    margin-bottom: 1px;
}

.preview-level-name {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.preview-level-desc {
    font-size: 20px;
    color: rgb(148, 163, 184);
    white-space: normal;
    margin-bottom: 6px;
}

.preview-chips-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: auto;
}

.preview-chip {
    flex-grow: 1;
    margin: 0 3px;
    height: 144px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    align-items: center;
    justify-content: center;
    padding: 2px 4px;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.chip-val {
    font-size: 20px;
    -unity-font-style: bold;
}

.val-diff {
    color: rgb(255, 170, 0);
}

.val-stars {
    color: rgb(255, 215, 0);
}

.val-time {
    color: rgb(33, 212, 253);
}

.chip-label {
    font-size: 16px;
    color: rgb(100, 116, 139);
    letter-spacing: 0.5px;
}

.level-play-action-btn {
    height: 128px;
    border-radius: 26px;
    background-color: rgb(255, 59, 119);
    border-color: rgb(33, 212, 253);
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
    box-shadow: 0 0 16px rgba(255, 59, 119, 0.5);
}

.level-play-action-btn:hover {
    background-color: rgb(255, 84, 142);
    border-color: rgb(255, 255, 255);
    scale: 1.03 1.03;
}

.leaderboard-card {
    width: 840px;
}

.leaderboard-table {
    margin-top: 6px;
    margin-bottom: 16px;
}

.score-row {
    height: 80px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    margin-bottom: 6px;
    padding: 0 16px;
    width: 85%;
    align-self: center;
    margin-top: 6px;
    margin-right: 6px;
    margin-left: 6px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.row-gold {
    background-color: rgba(255, 215, 0, 0.12);
    border-color: rgba(255, 215, 0, 0.45);
    width: 100%;
    height: 100px;
    margin-top: 12px;
    margin-right: 12px;
    margin-bottom: 6px;
    margin-left: 12px;
}

.row-silver {
    background-color: rgba(226, 232, 240, 0.1);
    border-color: rgba(226, 232, 240, 0.38);
    width: 95%;
    height: 100px;
    margin-top: 6px;
    margin-right: 12px;
    margin-bottom: 6px;
    margin-left: 12px;
}

.row-bronze {
    background-color: rgba(205, 127, 50, 0.1);
    border-color: rgba(205, 127, 50, 0.38);
    width: 90%;
    height: 100px;
    margin-top: 6px;
    margin-right: 12px;
    margin-bottom: 12px;
    margin-left: 12px;
}

.rank-badge-pod {
    flex-direction: row;
    align-items: center;
    width: 160px;
}

.medal-icon {
    width: 64px;
    height: 64px;
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.icon-gold {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Gold.png?fileID=21300000&guid=49e1ff47be1e4d7449ce42ffe621b576&type=3#TX_Medal_Gold");
}

.icon-silver {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Silver.png?fileID=21300000&guid=f7805189d97536541b31bb823665894c&type=3#TX_Medal_Silver");
}

.icon-bronze {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Bronze.png?fileID=21300000&guid=644f3d4abae177341b78bebc8b2f6968&type=3#TX_Medal_Bronze");
}

.rank-label {
    font-size: 32px;
    -unity-font-style: bold;
}

.label-gold {
    color: rgb(255, 215, 0);
}

.label-silver {
    color: rgb(226, 232, 240);
}

.label-bronze {
    color: rgb(205, 127, 50);
}

.rank-num-label {
    width: 120px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(148, 163, 184);
}

.score-row-value {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}

.val-gold {
    color: rgb(255, 215, 0);
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.6);
    font-size: 36px;
}

.val-silver {
    color: rgb(226, 232, 240);
    text-shadow: 0 0 8px rgba(226, 232, 240, 0.6);
    font-size: 36px;
}

.val-bronze {
    color: rgb(205, 127, 50);
    text-shadow: 0 0 8px rgba(205, 127, 50, 0.6);
    font-size: 36px;
}

.score-row-date {
    font-size: 26px;
    color: rgb(100, 116, 139);
    width: 92px;
    -unity-text-align: middle-right;
}

.warning-btn {
    background-color: rgba(225, 29, 72, 0.18);
    border-color: rgba(244, 63, 94, 0.6);
    color: rgb(251, 113, 133);
}

.warning-btn:hover {
    background-color: rgb(225, 29, 72);
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
}

.warning-btn:active {
    background-color: rgb(190, 18, 60);
}

.how-to-play-card {
    width: 840px;
    max-height: 660px;
}

.guide-scroll {
    max-height: 490px;
    margin-bottom: 6px;
    margin-top: 6px;
    margin-right: 6px;
    margin-left: 6px;
}

.guide-card {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 16px;
    margin-bottom: 6px;
    margin-top: 6px;
    margin-right: 6px;
    margin-left: 6px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.guide-heading {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(33, 212, 253);
    letter-spacing: 1px;
    margin-bottom: 7px;
}

.guide-text {
    font-size: 28px;
    color: rgb(203, 213, 225);
    white-space: normal;
}

.credits-card {
    width: 840px;
}

.credit-author {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(33, 212, 253);
    align-self: center;
    margin-bottom: 18px;
}

.credit-links-container {
    flex-direction: column;
    margin-bottom: 16px;
}

.credit-link-btn {
    height: 96px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(33, 212, 253, 0.35);
    background-color: rgba(33, 212, 253, 0.08);
    color: rgb(33, 212, 253);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 18px;
    padding-right: 18px;
    scale: 1 1;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s, 0.15s, 0.15s;
    transition-timing-function: ease-out-back;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.credit-link-btn:hover {
    scale: 1.03 1.03;
    background-color: rgba(33, 212, 253, 0.25);
    border-color: rgb(33, 212, 253);
    color: rgb(255, 255, 255);
}

.credit-link-btn:active {
    scale: 0.96 0.96;
    background-color: rgba(33, 212, 253, 0.06);
}

.credit-icon {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-mail {
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_Mail.png?fileID=21300000&guid=ebe29a6576d52b24ebc63caee9636561&type=3#TX_Icon_Mail");
    -unity-background-image-tint-color: rgb(33, 212, 253);
}

.icon-web {
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_Web.png?fileID=21300000&guid=baee02911da2ea94cab2866cf0239bef&type=3#TX_Icon_Web");
    -unity-background-image-tint-color: rgb(33, 212, 253);
}

.icon-linkedin {
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_LinkedIn.png?fileID=21300000&guid=4b5ac813a7fbda241b71c7f7874d0123&type=3#TX_Icon_LinkedIn");
    -unity-background-image-tint-color: rgb(33, 212, 253);
}

.icon-github {
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_GitHub.png?fileID=21300000&guid=95f1dbecc80c4d94eb42252450d30de2&type=3#TX_Icon_GitHub");
    -unity-background-image-tint-color: rgb(33, 212, 253);
}

.credit-btn-text {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
}

.setting-lang-group {
    flex-direction: row;
    align-items: center;
}

.lang-btn {
    width: 68px;
    height: 68px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    color: rgb(148, 163, 184);
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 6px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.15s;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
}

.lang-btn:hover {
    scale: 1.05 1.05;
    background-color: rgba(255, 255, 255, 0.15);
}

.lang-btn-active {
    background-color: rgb(33, 212, 253);
    border-color: rgb(110, 227, 255);
    color: rgb(8, 10, 20);
}

.flag-icon {
    width: 64px;
    height: 64px;
    margin-right: 0;
    border-radius: 2px;
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.flag-gb {
    background-image: url("project://database/Assets/UI/Icons/TX_Flag_GB.png?fileID=21300000&guid=edb8ea2efda138f478df74c1eb804bca&type=3#TX_Flag_GB");
}

.flag-tr {
    background-image: url("project://database/Assets/UI/Icons/TX_Flag_TR.png?fileID=21300000&guid=fb59304eb0b2d6847ad8f39291a43817&type=3#TX_Flag_TR");
}

.lang-btn-text {
    font-size: 0;
    -unity-font-style: bold;
    color: inherit;
    margin: 0;
    padding: 0;
}

.credit-footnote {
    font-size: 26px;
    color: rgb(100, 116, 139);
    align-self: center;
    margin-bottom: 10px;
}

.setting-toggle {
    height: 102px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    justify-content: center;
}

.setting-toggle .unity-toggle__input {
    justify-content: flex-end;
    align-items: center;
}

.setting-toggle .unity-toggle__checkmark {
    width: 68px;
    height: 68px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(33, 212, 253, 0.45);
    background-color: rgba(33, 212, 253, 0.12);
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Icons/TX_Volume_Up.png?fileID=21300000&guid=9b70a43178d3e484aaa75e906b4ade94&type=3#TX_Volume_Up");
    -unity-background-image-tint-color: rgb(33, 212, 253);
    scale: 1 1;
    transition-property: scale, background-color, border-color, -unity-background-image-tint-color;
    transition-duration: 0.2s, 0.15s, 0.15s, 0.2s;
    transition-timing-function: ease-out-back;
}

.setting-toggle:hover .unity-toggle__checkmark,
.setting-toggle > .unity-toggle__input:hover > .unity-toggle__checkmark {
    scale: 1.1 1.1;
    border-color: rgb(33, 212, 253);
    background-color: rgba(33, 212, 253, 0.25);
}

.setting-toggle:checked .unity-toggle__checkmark,
.setting-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    border-color: rgba(255, 59, 86, 0.55);
    background-color: rgba(255, 59, 86, 0.16);
    background-image: url("project://database/Assets/UI/Icons/TX_Volume_Mute.png?fileID=21300000&guid=19323d3393a6acb4c9810de7a485552e&type=3#TX_Volume_Mute");
    -unity-background-image-tint-color: rgb(255, 59, 86);
}

.setting-toggle:checked:hover .unity-toggle__checkmark,
.setting-toggle > .unity-toggle__input:checked:hover > .unity-toggle__checkmark {
    scale: 1.1 1.1;
    border-color: rgb(255, 84, 108);
    background-color: rgba(255, 59, 86, 0.3);
    -unity-background-image-tint-color: rgb(255, 110, 130);
}

