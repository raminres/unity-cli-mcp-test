.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    padding: 0;
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
}

.main-menu-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.header-container {
    align-items: center;
    margin-bottom: 40px;
}

.game-title {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 62px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin: 0;
    padding: 0;
}

.title-highlight {
    color: #ff3b56;
    text-shadow: 0 0 15px rgba(255, 59, 86, 0.6);
}

.title-main {
    color: #21d4fd;
    text-shadow: 0 0 15px rgba(33, 212, 253, 0.6);
    margin-top: -10px;
}

.subtitle {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 16px;
    color: #8fa0c0;
    letter-spacing: 3px;
    margin-top: 8px;
}

.menu-card {
    width: 410px;
    background-color: rgba(22, 28, 44, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 28px;
    padding: 28px 24px;
    align-items: stretch;
}

/* Bouncy Arcade Buttons */
.arcade-button {
    height: 64px;
    border-radius: 18px;
    border-width: 1.5px;
    margin-bottom: 14px;
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color, translate;
    transition-duration: 0.25s, 0.15s, 0.15s, 0.25s;
    transition-timing-function: ease-out-back;
}

.arcade-button:hover {
    scale: 1.05 1.05;
    translate: 0 -2px;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.arcade-button:active {
    scale: 0.92 0.92;
    translate: 0 3px;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

.primary-btn {
    background-color: #ff3b56;
    border-color: #ff6e82;
    color: #ffffff;
}

.primary-btn:hover {
    background-color: #ff546c;
    border-color: #ffffff;
}

.primary-btn:active {
    background-color: #d81e3a;
    border-color: #ff3b56;
}

.secondary-btn {
    background-color: #21d4fd;
    border-color: #6ee3ff;
    color: #0c0d16;
}

.secondary-btn:hover {
    background-color: #55e3ff;
    border-color: #ffffff;
}

.secondary-btn:active {
    background-color: #0bb5dc;
    border-color: #21d4fd;
}

.default-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
}

.default-btn:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
}

.default-btn:active {
    background-color: rgba(255, 255, 255, 0.04);
}

/* Modals */
.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(4, 6, 14, 0.94);
    align-items: center;
    justify-content: center;
}

/* Custom Sleek Scroller */
.unity-scroller #unity-low-button,
.unity-scroller #unity-high-button {
    display: none;
    width: 0;
    height: 0;
}

.unity-scroller--vertical {
    width: 8px;
    margin-right: 2px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(33, 212, 253, 0.55);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: #21d4fd;
}

.modal-hidden {
    display: none;
}

.modal-card {
    width: 420px;
    background-color: #171c2c;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 28px;
    padding: 32px 28px;
}

.modal-title {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 28px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    align-self: center;
    margin-bottom: 18px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.setting-label {
    font-size: 17px;
    color: #cbd5e1;
}

.setting-slider {
    width: 170px;
}

.fps-btn {
    width: 110px;
    height: 42px;
    border-radius: 12px;
    background-color: #252e46;
    border-color: rgba(255, 255, 255, 0.2);
    color: #21d4fd;
    -unity-font-style: bold;
    font-size: 16px;
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.fps-btn:hover {
    scale: 1.08 1.08;
    background-color: #2e3a58;
    transition-timing-function: ease-out-back;
}

.fps-btn:active {
    scale: 0.92 0.92;
    transition-duration: 0.08s;
}

.modal-close-btn {
    margin-top: 16px;
    margin-bottom: 0;
}

.credit-highlight {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 19px;
    -unity-font-style: bold;
    color: #21d4fd;
    margin-bottom: 12px;
    align-self: center;
}

.credit-body {
    font-size: 16px;
    color: #94a3b8;
    margin-bottom: 7px;
    align-self: center;
}

/* Level Select Modal Extensions */
.modal-card-wide {
    width: 510px;
}

.level-modal-card {
    width: 440px;
    max-height: 94%;
    background-color: #0d1222;
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.45);
    border-radius: 30px;
    padding: 24px 20px 20px 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
}

.level-modal-title {
    font-size: 26px;
    color: #ffffff;
    letter-spacing: 3px;
    margin-bottom: 2px;
    align-self: center;
}

.level-modal-subtitle {
    font-size: 14px;
    color: #7e8fa8;
    margin-bottom: 8px;
    align-self: center;
}

.cyan-pill-divider {
    width: 50px;
    height: 3px;
    background-color: #21d4fd;
    border-radius: 2px;
    align-self: center;
    margin-bottom: 14px;
    box-shadow: 0 0 8px #21d4fd;
}

.level-grid-scroll-view {
    height: 255px;
    margin-bottom: 12px;
}

.level-grid-scroll-view #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.level-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

.level-grid-card {
    width: 31%;
    height: 84px;
    margin-bottom: 10px;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: rgba(33, 212, 253, 0.28);
    background-color: rgba(18, 25, 45, 0.85);
    align-items: center;
    justify-content: center;
    padding: 4px;
    transition-property: scale, border-color, box-shadow, background-color;
    transition-duration: 0.18s;
}

.level-grid-card:hover {
    scale: 1.05 1.05;
    border-color: #21d4fd;
    background-color: rgba(26, 36, 64, 0.95);
}

.level-card-selected {
    border-color: #ff3b8d;
    background-color: rgba(33, 212, 253, 0.12);
    box-shadow: 0 0 18px rgba(255, 59, 141, 0.55), inset 0 0 10px rgba(33, 212, 253, 0.25);
    scale: 1.04 1.04;
}

.level-card-num {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 22px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 2px;
}

.level-card-stars-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
}

.card-star {
    font-size: 13px;
    margin: 0 1px;
}

.star-active {
    color: #ffd700;
}

.star-inactive {
    color: rgba(148, 163, 184, 0.3);
}

.level-card-time {
    font-size: 11px;
    color: #7e8fa8;
    -unity-font-style: bold;
}

.level-card-locked {
    opacity: 0.55;
    border-color: rgba(255, 255, 255, 0.12);
}

.level-card-lock-icon {
    font-size: 18px;
    color: #7e8fa8;
    margin-bottom: 2px;
}

.level-card-locked-label {
    font-size: 10px;
    color: #64748b;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.level-preview-card {
    width: 100%;
    min-height: 140px;
    flex-direction: row;
    background-color: rgba(10, 15, 28, 0.98);
    border-width: 1px;
    border-color: rgba(33, 212, 253, 0.3);
    border-radius: 18px;
    padding: 10px 12px;
    margin-bottom: 12px;
}

.level-preview-thumb {
    width: 86px;
    height: 118px;
    border-radius: 12px;
    background-color: rgba(6, 9, 18, 0.9);
    border-width: 1px;
    border-color: rgba(255, 59, 141, 0.35);
    margin-right: 12px;
    align-items: center;
    justify-content: center;
}

.preview-details {
    flex-grow: 1;
    flex-direction: column;
}

.preview-level-tag {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: #7e8fa8;
    -unity-font-style: bold;
    margin-bottom: 1px;
}

.preview-level-name {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
}

.preview-level-desc {
    font-size: 11px;
    color: #94a3b8;
    white-space: normal;
    margin-bottom: 6px;
}

.preview-chips-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: auto;
}

.preview-chip {
    flex-grow: 1;
    margin: 0 3px;
    height: 28px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    align-items: center;
    justify-content: center;
    padding: 2px 4px;
}

.chip-val {
    font-size: 11px;
    -unity-font-style: bold;
}

.val-diff {
    color: #ffaa00;
}

.val-stars {
    color: #ffd700;
}

.val-time {
    color: #21d4fd;
}

.chip-label {
    font-size: 8px;
    color: #64748b;
    letter-spacing: 0.5px;
}

.level-play-action-btn {
    height: 52px;
    border-radius: 26px;
    background-color: #ff3b77;
    border-color: #21d4fd;
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
    box-shadow: 0 0 16px rgba(255, 59, 119, 0.5);
}

.level-play-action-btn:hover {
    background-color: #ff548e;
    border-color: #ffffff;
    scale: 1.03 1.03;
}


/* Leaderboard & High Scores Modal */
.leaderboard-card {
    width: 530px;
}

.leaderboard-table {
    margin-top: 6px;
    margin-bottom: 16px;
}

.score-row {
    height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    margin-bottom: 5px;
    padding: 0 16px;
}

.row-gold {
    background-color: rgba(255, 215, 0, 0.12);
    border-color: rgba(255, 215, 0, 0.45);
}

.row-silver {
    background-color: rgba(226, 232, 240, 0.10);
    border-color: rgba(226, 232, 240, 0.38);
}

.row-bronze {
    background-color: rgba(205, 127, 50, 0.10);
    border-color: rgba(205, 127, 50, 0.38);
}

.rank-badge-pod {
    flex-direction: row;
    align-items: center;
    width: 78px;
}

.medal-icon {
    width: 26px;
    height: 26px;
    margin-right: 7px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-gold {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Gold.png?fileID=21300000&guid=49e1ff47be1e4d7449ce42ffe621b576&type=3#TX_Medal_Gold");
}

.icon-silver {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Silver.png?fileID=21300000&guid=f7805189d97536541b31bb823665894c&type=3#TX_Medal_Silver");
}

.icon-bronze {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Bronze.png?fileID=21300000&guid=644f3d4abae177341b78bebc8b2f6968&type=3#TX_Medal_Bronze");
}

.rank-label {
    font-size: 16px;
    -unity-font-style: bold;
}

.label-gold {
    color: #ffd700;
}

.label-silver {
    color: #e2e8f0;
}

.label-bronze {
    color: #cd7f32;
}

.rank-num-label {
    width: 78px;
    font-size: 15px;
    -unity-font-style: bold;
    color: #94a3b8;
}

.score-row-value {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 18px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 1px;
}

.val-gold {
    color: #ffd700;
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.6);
}

.val-silver {
    color: #e2e8f0;
    text-shadow: 0 0 8px rgba(226, 232, 240, 0.6);
}

.val-bronze {
    color: #cd7f32;
    text-shadow: 0 0 8px rgba(205, 127, 50, 0.6);
}

.score-row-date {
    font-size: 13px;
    color: #64748b;
    width: 92px;
    -unity-text-align: middle-right;
}

.warning-btn {
    background-color: rgba(225, 29, 72, 0.18);
    border-color: rgba(244, 63, 94, 0.6);
    color: #fb7185;
}

.warning-btn:hover {
    background-color: #e11d48;
    border-color: #ffffff;
    color: #ffffff;
}

.warning-btn:active {
    background-color: #be123c;
}

/* How To Play Modal */
.how-to-play-card {
    width: 550px;
    max-height: 660px;
}

.guide-scroll {
    max-height: 490px;
    margin-bottom: 14px;
}

.guide-card {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 16px;
    margin-bottom: 12px;
}

.guide-heading {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 16px;
    -unity-font-style: bold;
    color: #21d4fd;
    letter-spacing: 1px;
    margin-bottom: 7px;
}

.guide-text {
    font-size: 14px;
    color: #cbd5e1;
    white-space: normal;
}

/* Credits Modal Interactive Links */
.credits-card {
    width: 530px;
}

.credit-author {
    font-size: 17px;
    -unity-font-style: bold;
    color: #21d4fd;
    align-self: center;
    margin-bottom: 18px;
}

.credit-links-container {
    flex-direction: column;
    margin-bottom: 16px;
}

.credit-link-btn {
    height: 52px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(33, 212, 253, 0.35);
    background-color: rgba(33, 212, 253, 0.08);
    color: #21d4fd;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 18px;
    padding-right: 18px;
    scale: 1 1;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s, 0.15s, 0.15s;
    transition-timing-function: ease-out-back;
}

.credit-link-btn:hover {
    scale: 1.03 1.03;
    background-color: rgba(33, 212, 253, 0.25);
    border-color: #21d4fd;
    color: #ffffff;
}

.credit-link-btn:active {
    scale: 0.96 0.96;
    background-color: rgba(33, 212, 253, 0.06);
}

.credit-icon {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-mail {
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_Mail.png?fileID=21300000&guid=ebe29a6576d52b24ebc63caee9636561&type=3#TX_Icon_Mail_0");
    -unity-background-image-tint-color: #21d4fd;
}

.icon-web {
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_Web.png?fileID=21300000&guid=baee02911da2ea94cab2866cf0239bef&type=3#TX_Icon_Web_0");
    -unity-background-image-tint-color: #21d4fd;
}

.icon-linkedin {
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_LinkedIn.png?fileID=21300000&guid=4b5ac813a7fbda241b71c7f7874d0123&type=3#TX_Icon_LinkedIn_0");
    -unity-background-image-tint-color: #21d4fd;
}

.icon-github {
    background-image: url("project://database/Assets/UI/Icons/TX_Icon_GitHub.png?fileID=21300000&guid=95f1dbecc80c4d94eb42252450d30de2&type=3#TX_Icon_GitHub_0");
    -unity-background-image-tint-color: #21d4fd;
}

.credit-btn-text {
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
}

/* Language selector buttons in Options modal */
.setting-lang-group {
    flex-direction: row;
    align-items: center;
}

.lang-btn {
    width: 68px;
    height: 38px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    color: #94a3b8;
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 6px;
    padding-right: 6px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.15s;
}

.lang-btn:hover {
    scale: 1.05 1.05;
    background-color: rgba(255, 255, 255, 0.15);
}

.lang-btn-active {
    background-color: #21d4fd;
    border-color: #6ee3ff;
    color: #080a14;
}

.flag-icon {
    width: 20px;
    height: 14px;
    margin-right: 5px;
    border-radius: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.flag-gb {
    background-image: url("project://database/Assets/UI/Icons/TX_Flag_GB.png?fileID=21300000&guid=edb8ea2efda138f478df74c1eb804bca&type=3#TX_Flag_GB_0");
}

.flag-tr {
    background-image: url("project://database/Assets/UI/Icons/TX_Flag_TR.png?fileID=21300000&guid=fb59304eb0b2d6847ad8f39291a43817&type=3#TX_Flag_TR_0");
}

.lang-btn-text {
    font-size: 13px;
    -unity-font-style: bold;
    color: inherit;
    margin: 0;
    padding: 0;
}

.credit-footnote {
    font-size: 13px;
    color: #64748b;
    align-self: center;
    margin-bottom: 10px;
}
