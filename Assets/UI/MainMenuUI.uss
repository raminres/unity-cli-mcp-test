.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #0c0d16;
    align-items: center;
    justify-content: center;
    padding: 30px;
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Inter.ttf?fileID=12800000&guid=c32a959b960d5234baae7b3519c3828a&type=3#FT_Inter");
}

.bg-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    background-color: rgba(33, 212, 253, 0.08);
    border-radius: 250px;
}

.header-container {
    align-items: center;
    margin-bottom: 35px;
}

.game-title {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin: 0;
    padding: 0;
}

.title-highlight {
    color: #ff3b56;
    text-shadow: 0 0 15px rgba(255, 59, 86, 0.6);
}

.title-main {
    color: #21d4fd;
    text-shadow: 0 0 15px rgba(33, 212, 253, 0.6);
    margin-top: -10px;
}

.subtitle {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 14px;
    color: #8fa0c0;
    letter-spacing: 3px;
    margin-top: 8px;
}

.menu-card {
    width: 350px;
    background-color: rgba(22, 28, 44, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 24px 20px;
    align-items: stretch;
}

/* Bouncy Arcade Buttons */
.arcade-button {
    height: 56px;
    border-radius: 16px;
    border-width: 1.5px;
    margin-bottom: 12px;
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color, translate;
    transition-duration: 0.25s, 0.15s, 0.15s, 0.25s;
    transition-timing-function: ease-out-back;
}

.arcade-button:hover {
    scale: 1.05 1.05;
    translate: 0 -2px;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.arcade-button:active {
    scale: 0.92 0.92;
    translate: 0 3px;
    transition-duration: 0.08s;
    transition-timing-function: ease-in-out;
}

.primary-btn {
    background-color: #ff3b56;
    border-color: #ff6e82;
    color: #ffffff;
}

.primary-btn:hover {
    background-color: #ff546c;
    border-color: #ffffff;
}

.primary-btn:active {
    background-color: #d81e3a;
    border-color: #ff3b56;
}

.secondary-btn {
    background-color: #21d4fd;
    border-color: #6ee3ff;
    color: #0c0d16;
}

.secondary-btn:hover {
    background-color: #55e3ff;
    border-color: #ffffff;
}

.secondary-btn:active {
    background-color: #0bb5dc;
    border-color: #21d4fd;
}

.default-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
}

.default-btn:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
}

.default-btn:active {
    background-color: rgba(255, 255, 255, 0.04);
}

/* Modals */
.modal-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 10, 18, 0.85);
    align-items: center;
    justify-content: center;
}

.modal-hidden {
    display: none;
}

.modal-card {
    width: 360px;
    background-color: #171c2c;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 24px;
    padding: 28px 24px;
}

.modal-title {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 24px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
    align-self: center;
    margin-bottom: 16px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.setting-label {
    font-size: 15px;
    color: #cbd5e1;
}

.setting-slider {
    width: 150px;
}

.fps-btn {
    width: 95px;
    height: 36px;
    border-radius: 10px;
    background-color: #252e46;
    border-color: rgba(255, 255, 255, 0.2);
    color: #21d4fd;
    -unity-font-style: bold;
    font-size: 14px;
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.fps-btn:hover {
    scale: 1.08 1.08;
    background-color: #2e3a58;
    transition-timing-function: ease-out-back;
}

.fps-btn:active {
    scale: 0.92 0.92;
    transition-duration: 0.08s;
}

.modal-close-btn {
    margin-top: 14px;
    margin-bottom: 0;
}

.credit-highlight {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 17px;
    -unity-font-style: bold;
    color: #21d4fd;
    margin-bottom: 10px;
    align-self: center;
}

.credit-body {
    font-size: 14px;
    color: #94a3b8;
    margin-bottom: 6px;
    align-self: center;
}

/* Level Select Modal Extensions */
.modal-card-wide {
    width: 440px;
}

.level-tabs-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 14px;
}

.level-tab-btn {
    flex-grow: 1;
    min-width: 80px;
    height: 40px;
    margin: 3px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s, 0.15s, 0.15s;
    transition-timing-function: ease-out-back;
}

.level-tab-btn:hover {
    scale: 1.05 1.05;
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(33, 212, 253, 0.6);
}

.level-tab-btn:active {
    scale: 0.94 0.94;
}

.level-tab-active {
    background-color: #21d4fd;
    border-color: #21d4fd;
    color: #0c0d16;
}

.level-tab-active:hover {
    background-color: #55ddfe;
    border-color: #55ddfe;
    color: #0c0d16;
}

.level-name-display {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 18px;
    -unity-font-style: bold;
    color: #21d4fd;
    align-self: center;
    margin-bottom: 6px;
    letter-spacing: 0.5px;
}

.level-desc-display {
    font-size: 13px;
    color: #94a3b8;
    align-self: center;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.modal-action-btn {
    margin-top: 10px;
}

/* Leaderboard & High Scores Modal */
.leaderboard-card {
    width: 460px;
}

.leaderboard-table {
    margin-top: 6px;
    margin-bottom: 14px;
}

.score-row {
    height: 38px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    margin-bottom: 4px;
    padding: 0 14px;
}

.row-gold {
    background-color: rgba(255, 215, 0, 0.12);
    border-color: rgba(255, 215, 0, 0.45);
}

.row-silver {
    background-color: rgba(226, 232, 240, 0.10);
    border-color: rgba(226, 232, 240, 0.38);
}

.row-bronze {
    background-color: rgba(205, 127, 50, 0.10);
    border-color: rgba(205, 127, 50, 0.38);
}

.rank-badge-pod {
    flex-direction: row;
    align-items: center;
    width: 68px;
}

.medal-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-gold {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Gold.png?fileID=21300000&guid=49e1ff47be1e4d7449ce42ffe621b576&type=3#TX_Medal_Gold_0");
}

.icon-silver {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Silver.png?fileID=21300000&guid=f7805189d97536541b31bb823665894c&type=3#TX_Medal_Silver_0");
}

.icon-bronze {
    background-image: url("project://database/Assets/UI/Icons/TX_Medal_Bronze.png?fileID=21300000&guid=644f3d4abae177341b78bebc8b2f6968&type=3#TX_Medal_Bronze_0");
}

.rank-label {
    font-size: 14px;
    -unity-font-style: bold;
}

.label-gold {
    color: #ffd700;
}

.label-silver {
    color: #e2e8f0;
}

.label-bronze {
    color: #cd7f32;
}

.rank-num-label {
    width: 68px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #94a3b8;
}

.score-row-value {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 1px;
}

.val-gold {
    color: #ffd700;
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.6);
}

.val-silver {
    color: #e2e8f0;
    text-shadow: 0 0 8px rgba(226, 232, 240, 0.6);
}

.val-bronze {
    color: #cd7f32;
    text-shadow: 0 0 8px rgba(205, 127, 50, 0.6);
}

.score-row-date {
    font-size: 11px;
    color: #64748b;
    width: 80px;
    -unity-text-align: middle-right;
}

.warning-btn {
    background-color: rgba(225, 29, 72, 0.18);
    border-color: rgba(244, 63, 94, 0.6);
    color: #fb7185;
}

.warning-btn:hover {
    background-color: #e11d48;
    border-color: #ffffff;
    color: #ffffff;
}

.warning-btn:active {
    background-color: #be123c;
}

/* How To Play Modal */
.how-to-play-card {
    width: 480px;
    max-height: 580px;
}

.guide-scroll {
    max-height: 420px;
    margin-bottom: 12px;
}

.guide-card {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 14px;
    margin-bottom: 10px;
}

.guide-heading {
    -unity-font: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FT_Montserrat.ttf?fileID=12800000&guid=a40a993daa5255e4e87cad89b720cf04&type=3#FT_Montserrat");
    font-size: 14px;
    -unity-font-style: bold;
    color: #21d4fd;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.guide-text {
    font-size: 12.5px;
    color: #cbd5e1;
    white-space: normal;
    line-height: 17px;
}

/* Credits Modal Interactive Links */
.credits-card {
    width: 460px;
}

.credit-author {
    font-size: 15px;
    -unity-font-style: bold;
    color: #21d4fd;
    align-self: center;
    margin-bottom: 16px;
}

.credit-links-container {
    flex-direction: column;
    margin-bottom: 14px;
}

.credit-link-btn {
    height: 46px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(33, 212, 253, 0.35);
    background-color: rgba(33, 212, 253, 0.08);
    color: #21d4fd;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s, 0.15s, 0.15s;
    transition-timing-function: ease-out-back;
}

.credit-link-btn:hover {
    scale: 1.03 1.03;
    background-color: rgba(33, 212, 253, 0.25);
    border-color: #21d4fd;
    color: #ffffff;
}

.credit-link-btn:active {
    scale: 0.96 0.96;
    background-color: rgba(33, 212, 253, 0.06);
}

.credit-footnote {
    font-size: 11px;
    color: #64748b;
    align-self: center;
    margin-bottom: 10px;
}
